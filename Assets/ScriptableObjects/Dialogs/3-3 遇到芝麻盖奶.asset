  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "3-3 \u9047\u5230\u829D\u9EBB\u76D6\u5976"
  m_EditorClassIdentifier: 
  dialogID: 303
  DialogLines:
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u563B\u563B\u563B\uFF0C\u563F\u563F\u563F\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4F60\u4EEC\u770B\uFF0C\u90A3\u4E2A\u54C8\u57FA\u7C73\u5728\u90A3\u513F\u5077\u5077\u7B11\u4EC0\u4E48\u5462\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u4ED6\u521A\u597D\u6321\u5728\u6211\u4EEC\u51FA\u53BB\u7684\u8DEF\u4E0A\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u5582\uFF0C\u90A3\u8FB9\u90A3\u4F4D\uFF0C\u4F60\u53EF\u4EE5\u8BA9\u5F00\u4E00\u4E0B\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u4EC0\u4E48\u732B\uFF01\uFF1F\u522B\u5927\u58F0\u56B7\u56B7\uFF01\u2026\u2026\u55EF\uFF1F\u4F60\u4EEC\u4E0D\u662F\u54C8\u57FA\u7C73\uFF0C\u4F60\u4EEC\u662F\u4EC0\u4E48\u4E1C\u897F\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6211\u4EEC\u4E0D\u662F\u4EC0\u4E48\u4E1C\u897F\uFF0C\u6211\u4EEC\u662F\u9AD8\u8D35\u7684\u5730\u7403\u4EBA\u3002"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u54C8\u2014\u2014\uFF01\u5351\u9119\u65E0\u803B\u7684\u5730\u7403\u4EBA\uFF0C\u4F60\u4EEC\u600E\u4E48\u4F1A\u5728\u6211\u4EEC\u66FC\u6CE2\u661F\u7684\u661F\u8230\u4E0A\uFF01\uFF1F\n\u4E0D\u8FC7\u561B\uFF0C\u563F\u563F\u563F\uFF0C\u4F60\u4EEC\u5730\u7403\u4EBA\u9A6C\u4E0A\u5C31\u8981\u5012\u9709\u54AF\uFF0C\u563B\u563B\u563B\u3002"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u521A\u624D\u53F8\u4EE4\u5B98\u4E0B\u8FBE\u547D\u4EE4\u8BF4\uFF0C\u8BA9\u829D\u9EBB\u76D6\u5976\uFF0C\u4E5F\u5C31\u662F\u672C\u4F20\u4EE4\u5B98\uFF0C\u53BB\u901A\u77E5\u6B66\u5668\u63A7\u5236\u4E2D\u5FC3\u4E00\u6761\u91CD\u8981\u6D88\u606F\u3002\u4F46\u662F\u6211\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\u7A81\u7136\u5934\u4E00\u6655\uFF0C\u7136\u540E\u5C31\u4E0D\u5C0F\u5FC3\u8BF4\u9519\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4E0D\u662F\u91CD\u8981\u6D88\u606F\u561B\uFF0C\u8FD8\u80FD\u8BF4\u9519\u554A\uFF01\u4F60\u5230\u5E95\u600E\u4E48\u5F53\u4E0A\u4F20\u4EE4\u5B98\u7684\u554A\uFF01"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u7A81\u7136\u5934\u4E00\u6655\uFF1F\u96BE\u9053\u662F\u65F6\u7A7A\u6CE2\u52A8\u5F15\u8D77\u7684\uFF1F"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u8FD9\u53EF\u80FD\u548C\u6211\u4EEC\u5728\u8FD9\u4E2A\u65F6\u7A7A\u8981\u4FEE\u6B63\u7684\u4E8B\u4EF6\u6709\u5173\u3002\u5FEB\u8BF4\uFF0C\u4F60\u4F20\u9519\u4E86\u4EC0\u4E48\u6D88\u606F\uFF1F"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u563F\u563F\u563F\uFF0C\u6307\u6325\u5B98\u539F\u672C\u8BA9\u6211\u4F20\u4EE4\u7ED9\u6B66\u5668\u63A7\u5236\u4E2D\u5FC3\uFF0C\u5341\u5206\u949F\u540E\u6D3E\u51FA\u65E0\u4EBA\u673A\u5077\u88AD\u5730\u7403\u603B\u7EDF\u5E9C\u7684\u98DF\u5802\u7684\u98DF\u6750\u4ED3\u5E93\uFF0C\u628A\u4ED6\u4EEC\u7684\u7F8E\u5473\u5C0F\u9999\u80A0\u5077\u5149\uFF0C\u53EA\u7ED9\u4ED6\u4EEC\u7559\u4E00\u9897\u5377\u5FC3\u83DC\uFF0C\u6C14\u6B7B\u4ED6\u4EEC\u3002"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u4F46\u662F\u6211\u4E00\u4E0D\u5C0F\u5FC3\u8BF4\u6210\u4E86\uFF1A\u5341\u5206\u949F\u540E\uFF0C\u4F7F\u7528\u66FC\u6CE2\u661F\u6700\u5148\u8FDB\u7684\u963F\u59C6\u65AF\u7279\u6717\u6FC0\u5149\u70AE\u8FDC\u7A0B\u8F70\u70B8\u5730\u7403\u3002\u54C8\u54C8\uFF0C\u4F60\u4EEC\u8FD9\u4E9B\u5730\u7403\u4EBA\u80AF\u5B9A\u4E0D\u77E5\u9053\u963F\u59C6\u65AF\u7279\u6717\u6FC0\u5149\u70AE\u7684\u5A01\u529B\uFF0C\u5341\u5206\u949F\u540E\uFF0C\u5730\u7403\u5C31\u8981\u4ECE\u7403\u5F62\u53D8\u6210\u534A\u5706\u5F62\u5566\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u8FD9\u662F\u80FD\u4E0D\u5C0F\u5FC3\u8BF4\u9519\u7684\u5417\uFF01\uFF1F\u4E0D\u884C\uFF0C\u6211\u4EEC\u5F97\u8D76\u5FEB\u53BB\u6B66\u5668\u63A7\u5236\u4E2D\u5FC3\u7EA0\u6B63\u8FC7\u6765\uFF01"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u54C8\u2014\u2014\uFF01\uFF01\uFF01\n\u6709\u6211\u5728\u8FD9\u91CC\u5B88\u7740\uFF0C\u4F60\u4EEC\u8C01\u90FD\u522B\u60F3\u8FC7\u53BB\uFF01"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u4F60\u81EA\u5DF1\u4F20\u9519\u4E86\u547D\u4EE4\uFF0C\u8FD8\u62E6\u7740\u6211\u4EEC\u53BB\u5E2E\u4F60\u7EA0\u6B63\uFF1F\u4F60\u5C31\u4E0D\u6015\u6307\u6325\u5B98\u5904\u7F5A\u4F60\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u5C31\u7B97\u88AB\u5904\u7F5A\u6211\u4E5F\u5FC3\u7518\u60C5\u613F\uFF01\u66FC\u6CE2\u661F\u6709\u90A3\u4E48\u591A\u8BA8\u538C\u5730\u7403\u4EBA\u7684\u54C8\u57FA\u7C73\uFF0C\u6211\u4E0D\u60DC\u88AB\u7F5A\uFF0C\u6362\u6765\u5730\u7403\u7684\u706D\u4EA1\uFF0C\u8FD9\u662F\u820D\u751F\u53D6\u4E49\u7684\u58EE\u4E3E\uFF01"
