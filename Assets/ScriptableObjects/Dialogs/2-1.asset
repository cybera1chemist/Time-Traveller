  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: 2-1
  m_EditorClassIdentifier: 
  dialogID: 201
  DialogLines:
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u8FD9\u662F\u4EC0\u4E48\u60C5\u51B5\uFF1F\u6211\u4EEC\u8FD9\u662F\u5728\u54EA\u513F\uFF1F"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u4F60\u4EEC\u770B\u8FD9\u4E9B\u88C5\u7F6E\u2026\u2026\u8FD9\u91CC\u770B\u8D77\u6765\u4F3C\u4E4E\u662F\u4E2A\u7814\u7A76\u6240\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u800C\u4E14\uFF0C\u662F\u6B66\u5668\u7814\u7A76\u6240\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u8BF6\uFF0C\u6B66\u5668\u7814\u7A76\u6240\uFF1F\u90A3\u4E3A\u4EC0\u4E48\u6211\u4EEC\u4F1A\u7A81\u7136\u51FA\u73B0\u5728\u8FD9\u91CC\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4E4B\u524D\u7684\u5B87\u5B99\u6D77\u76D7\u4E0D\u662F\u8BF4\u4ECA\u5E74\u662F2110\u5E74\u5417\uFF1F\u73B0\u5728\u6211\u4EEC\u53C8\u7A81\u7136\u51FA\u73B0\u5728\u5947\u602A\u7684\u5730\u65B9\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6211\u4EEC\u80AF\u5B9A\u662F\u7A7F\u8D8A\u5230\u8FC7\u53BB\u4E86\uFF01\u4F46\u662F\uFF0C\u4E3A\u4EC0\u4E48\u4F1A\u7A7F\u8D8A\uFF0C\u53C8\u4E3A\u4EC0\u4E48\u7A81\u7136\u88AB\u4F20\u9001\uFF0C\u6211\u5C31\u4E0D\u6E05\u695A\u4E86\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u4F60\u4E0D\u662F\u65F6\u95F4\u4FE1\u606F\u5DE5\u7A0B\u4E13\u4E1A\u7684\u5417\uFF0C\u600E\u4E48\u8FD9\u90FD\u4E0D\u6E05\u695A\uFF0C\u4F60\u6709\u6CA1\u6709\u597D\u597D\u5B66\u4E60\u5440\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u90A3\u4F60\u4E0D\u8FD8\u662F\u5B66\u6CD5\u672F\u7684\u5417\uFF0C\u4F60\u5012\u662F\u7528\u9B54\u6CD5\u628A\u6211\u4EEC\u53D8\u56DE\u53BB\u5440\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u4E0D\u8BB8\u5435\u67B6\uFF01\u6211\u4EEC\u5148\u53BB\u641C\u5BFB\u7EBF\u7D22\uFF0C\u4F46\u662F\u8981\u5C0F\u5FC3\uFF0C\u8FD9\u91CC\u4E0D\u77E5\u9053\u6F5C\u4F0F\u7740\u4EC0\u4E48\u5371\u9669\u3002"
