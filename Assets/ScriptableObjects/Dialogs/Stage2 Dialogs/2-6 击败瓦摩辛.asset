  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "2-6 \u51FB\u8D25\u74E6\u6469\u8F9B"
  m_EditorClassIdentifier: 
  dialogID: 206
  DialogLines:
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u8C22\u8C22\u4F60\u4EEC\uFF0C\u5982\u679C\u4E0D\u662F\u4F60\u4EEC\u613F\u610F\u633A\u8EAB\u800C\u51FA\u4FDD\u62A4\u6211\uFF0C\u6211\u521A\u624D\u80AF\u5B9A\u90FD\u4E27\u547D\u597D\u51E0\u6B21\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u8001\u5E08\uFF0C\u522B\u8FD9\u4E48\u8BF4\uFF0C\u8FD9\u90FD\u662F\u6211\u4EEC\u8BE5\u505A\u7684\uFF01\n\u2026\u2026\u7B49\u7B49\uFF0C\u6211\u597D\u60F3\u60F3\u5230\u4E86\u4EC0\u4E48\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4E0A\u6B21\u6211\u4EEC\u7A7F\u8D8A\u52302110\u5E74\uFF0C\u963B\u6B62\u4E86\u5B87\u5B99\u6D77\u76D7\u6293\u8D70\u5B66\u6821\u7684\u5E08\u751F\uFF1B\u8FD9\u6B21\u53C8\u6765\u52302104\u5E74\uFF0C\u963B\u6B62\u4E86\u8FFD\u6740\u91D1\u9C7C\u8001\u5E08\u7684\u4EBA\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u7167\u8FD9\u6837\u8BF4\uFF0C\u5982\u679C\u6211\u4EEC\u6CA1\u6709\u7A7F\u8D8A\uFF0C\u90A3\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u5C31\u4F1A\u57282110\u5E74\u5012\u95ED\uFF0C\u91D1\u9C7C\u8001\u5E08\u4E5F\u4F1A\u57282104\u5E74\u88AB\u6740\u6B7B\u4E86\u624D\u5BF9\u3002"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u989D\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u7136\u800C\uFF0C\u8FD9\u6837\u5C31\u548C\u6211\u4EEC\u57282114\u5E74\u7684\u8BA4\u77E5\u77DB\u76FE\u4E86\uFF0C\u8FD9\u4E24\u4EF6\u4E8B\u90FD\u662F\u4E0D\u5E94\u8BE5\u53D1\u751F\u7684\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6CA1\u9519\uFF01\u6240\u4EE5\u6211\u63A8\u6D4B\uFF0C2114\u5E74\u7684\u5B9E\u9A8C\u4E8B\u6545\u5F15\u8D77\u7684\u65F6\u7A7A\u6CE2\u52A8\uFF0C\u4E0D\u4EC5\u5BFC\u81F4\u6211\u4EEC\u7A7F\u8D8A\uFF0C\u8FD8\u8BA9\u8FC7\u53BB\u7684\u4E00\u4E9B\u4E8B\u4EF6\u88AB\u6539\u53D8\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u539F\u6765\u5982\u6B64\u2026\u2026\u6211\u60F3\uFF0C\u65F6\u7A7A\u6295\u5F71\u88C5\u7F6E\u5C06\u6211\u4EEC\u9001\u56DE\u8FC7\u53BB\uFF0C\u662F\u5E0C\u671B\u6211\u4EEC\u4FEE\u590D\u8FC7\u53BB\u7684\u9519\u8BEF\u4E8B\u4EF6\u3002\u7B49\u6211\u4EEC\u4FEE\u590D\u5B8C\u8FD9\u4E9Bbug\uFF0C\u5E94\u8BE5\u5C31\u53EF\u4EE5\u56DE\u5230\u539F\u672C\u7684\u65F6\u7A7A\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u5509\uFF0C\u4F60\u4EEC\u906D\u9047\u7684\u8FD9\u4E9B\u6CE2\u6298\u90FD\u662F\u56E0\u4E3A\u6211\u7684\u7814\u7A76\uFF0C\u662F\u672A\u6765\u7684\u6211\u8FDE\u7D2F\u4E86\u4F60\u4EEC\uFF0C\u8BA9\u4F60\u4EEC\u8FD9\u4E9B\u5B69\u5B50\u7F6E\u8EAB\u4E8E\u5371\u9669\u4E2D\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u563F\u563F\uFF0C\u65E2\u7136\u6211\u4EEC\u90FD\u8FD9\u4E48\u8F9B\u82E6\u4E86\uFF0C\u90A3\u7B49\u6211\u4EEC\u56DE\u5230\u539F\u672C\u7684\u65F6\u7A7A\uFF0C\u8001\u5E08\u53EF\u5F97\u7ED9\u6211\u4EEC\u6BCF\u4E2A\u4EBA\u7684\u6210\u7EE9\u90FD\u6253A\u624D\u884C\u5440\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u8FD9\u8FD8\u4E0D\u591F\uFF01\u8FD8\u8981\u8BF7\u6211\u4EEC\u5403\u7CD6\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u54C8\u54C8\uFF0C\u60F3\u5403\u591A\u5C11\u7CD6\u90FD\u884C\u3002\n\u4F60\u4EEC\u4E00\u5B9A\u8981\u8DEF\u4E0A\u5C0F\u5FC3\u554A\u2026\u2026"
