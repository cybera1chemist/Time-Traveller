  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "1-7 \u8239\u957F\u51FA\u73B0"
  m_EditorClassIdentifier: 
  dialogID: 7
  DialogLines:
  - portrait: {fileID: 21300000, guid: 49729a0634a54054fba8985dd7c79dc7, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u4F60\u4EEC\u8FD9\u4E9B\u53EF\u6076\u7684\u5730\u7403\u4EBA\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u5C0F\u5FC3\uFF01\u770B\u4ED6\u7684\u6837\u5B50\uFF0C\u5E94\u8BE5\u662F\u201C\u840C\u840C\u5C0F\u54AA\u54AA\u201D\u53F7\u7684\u8230\u957F\uFF0C\u6A58\u80A5\u7F8E\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u4E0D\u662F\u5427\uFF0C\u662F\u90A3\u4E2A\u6076\u540D\u8FDC\u626C\u7684\u6050\u6016\u7684\u6A58\u80A5\u7F8E\u8239\u957F\uFF01\uFF1F\u6211\u4EEC\u600E\u4E48\u8FD9\u4E48\u5012\u9709\uFF0C\u7ADF\u7136\u9047\u5230\u4ED6\u4E86\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 49729a0634a54054fba8985dd7c79dc7, type: 3}
    speakerName: "\u6A58\u80A5\u7F8E\u8239\u957F"
    content: "\u5C31\u662F\u4F60\u4EEC\uFF0C\u6B3A\u8D1F\u6211\u7684\u5C0F\u5F1F\uFF0C\u7834\u574F\u6211\u7684\u8BA1\u5212\uFF01"
  - portrait: {fileID: 21300000, guid: 49729a0634a54054fba8985dd7c79dc7, type: 3}
    speakerName: "\u6A58\u80A5\u7F8E\u8239\u957F"
    content: "\u770B\u6211\u4E00\u70AE\u628A\u4F60\u4EEC\u8F70\u4E2A\u7A00\u5DF4\u70C2\uFF01"
