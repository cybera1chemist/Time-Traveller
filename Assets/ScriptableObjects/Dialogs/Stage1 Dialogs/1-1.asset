  dialogID: 1
  DialogLines:
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F\u4E3A\u4EC0\u4E48\u6211\u4F1A\u6655\u5012\uFF0C\u9192\u6765\u540E\u5B66\u6821\u5C31\u53D8\u6210\u4E86\u4E00\u7247\u5E9F\u589F\uFF01\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u5176\u4ED6\u540C\u5B66\u548C\u8001\u5E08\u4EEC\u53C8\u90FD\u53BB\u54EA\u4E86\uFF0C\u600E\u4E48\u53EA\u5269\u6211\u4E00\u4E2A\u4EBA\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u521A\u624D\u597D\u50CF\u770B\u5230\u51E0\u4E2A\u66FC\u6CE2\u661F\u7684\u54C8\u57FA\u7C73\uFF0C\u88C5\u626E\u50CF\u662F\u5B87\u5B99\u6D77\u76D7\uFF0C\u96BE\u9053\u662F\u4ED6\u4EEC\u88AD\u51FB\u4E86\u5B66\u6821\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u53EF\u662F\uFF0C\u5730\u7403\u548C\u66FC\u6CE2\u661F\u4E0D\u662F\u4E00\u76F4\u4E00\u6765\u90FD\u662F\u548C\u5E73\u53CB\u597D\u7684\u5417\uFF1F\u600E\u4E48\u4F1A\u7A81\u7136\u53D1\u751F\u88AD\u51FB\u4E8B\u4EF6\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u5148\u4E0D\u60F3\u8FD9\u4E48\u591A\u4E86\uFF0C\u5B66\u6821\u91CC\u73B0\u5728\u8FD9\u4E48\u5371\u9669\uFF0C\u6211\u5F97\u4FDD\u62A4\u597D\u81EA\u5DF1\uFF01\n\u5E78\u597D\u521A\u624D\u5728\u5E9F\u589F\u7684\u89D2\u843D\u91CC\u6361\u5230\u4E86\u4E00\u628A\u67AA\u2026\u2026"
