  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: 1-6
  m_EditorClassIdentifier: 
  dialogID: 6
  DialogLines:
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u674E\u561F\u561F\u540C\u5B66\uFF0C\u8BF8\u845B\u540C\u5B66\uFF0C\u8C1C\u5965\u540C\u5B66\uFF1F\u4F60\u4EEC\u600E\u4E48\u4F1A\u5728\u8FD9\u91CC\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u54C7\uFF01\u6D77\u85FB\uFF0C\u4F60\u4E5F\u5728\u554A\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\uFF08\u5BF9\u8C1C\u5965\u8033\u8BED\uFF09\u5979\u662F\u8C01\u554A\uFF0C\u600E\u4E48\u4F1A\u8BA4\u8BC6\u6211\u4EEC\u554A\uFF1F"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u5979\u662F\u6211\u4EEC\u9009\u7684\u865A\u62DF\u73B0\u5B9E\u6E38\u620F\u8BBE\u8BA1\u8BFE\u7684\u52A9\u6559\u554A\u2026\u2026\u4F60\u8FD9\u5BB6\u4F19\u5230\u5E95\u7FD8\u4E86\u591A\u5C11\u8282\u8BFE\u554A\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6D77\u85FB\uFF0C\u4F60\u662F\u4E0D\u662F\u4E5F\u662F\u5728\u6821\u5E86\u5178\u793C\u4E0A\u7684\u4E00\u573A\u7206\u70B8\u4E4B\u540E\u7A81\u7136\u5C31\u51FA\u73B0\u5728\u8FD9\u91CC\u4E86\uFF1F"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u6CA1\u9519\uFF0C\u6211\u9192\u6765\u4E4B\u540E\uFF0C\u770B\u5230\u4E24\u4E2A\u54C8\u57FA\u7C73\u62BC\u9001\u7740\u4E00\u7FA4\u5E08\u751F\uFF0C\u8981\u628A\u4ED6\u4EEC\u5173\u5230\u8FD9\u91CC\uFF0C\u4E8E\u662F\u6211\u5077\u5077\u628A\u4ED6\u4EEC\u6253\u6655\uFF0C\u628A\u5927\u5BB6\u653E\u8D70\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u54C7\uFF0C\u4F60\u597D\u5389\u5BB3\uFF01"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u6211\u8BA9\u4ED6\u4EEC\u5148\u8D70\uFF0C\u81EA\u5DF1\u6BBF\u540E\uFF0C\u6CA1\u60F3\u5230\u4ED6\u4EEC\u7684\u8001\u5927\u8FC7\u6765\u4E86\uFF0C\u4ED6\u975E\u5E38\u751F\u6C14\uFF0C\u5C31\u628A\u6211\u6293\u8D77\u6765\u5173\u5728\u8FD9\u91CC\u4E86\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u6CA1\u4E8B\u7684\uFF0C\u6211\u4EEC\u8FD9\u4E0D\u662F\u6765\u6551\u4F60\u4E86\u561B\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u6211\u4EEC\u5148\u79BB\u5F00\u8FD9\u91CC\u5427\uFF0C\u6B64\u5730\u4E0D\u5B9C\u4E45\u7559\u3002"
