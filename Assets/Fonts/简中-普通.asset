    characterSetSelectionMode: 8
    characterSequence: "\u6570\u5B57\uFF1A1234567890\r\n\u96F6\u4E00\u4E8C\u4E09\u56DB\u4E94\u516D\u4E03\u516B\u4E5D\u5341\u4E2A\u5341\u767E\u5343\u4E07\u4EBF\u5146\r\n\u6587\u6848\uFF1A\r\n\u5F00\u573A\u52A8\u753B\uFF1A\r\n22\u4E16\u7EAA\u4E0D\u4EC5\u662F\u4E00\u4E2A\u79D1\u6280\u9AD8\u5EA6\u53D1\u8FBE\u7684\u65F6\u4EE3\uFF0C\u4E5F\u662F\u4E00\u4E2A\u5145\u6EE1\u4EA4\u6D41\u4E0E\u878D\u5408\u7684\u65F6\u4EE3\u3002\u51E0\u5341\u5E74\u524D\uFF0C\u6765\u81EA\u66FC\u6CE2\u661F\u7403\u7684\u53CB\u597D\u5916\u661F\u4EBA\uFF08\u522B\u540D\u201C\u54C8\u57FA\u7C73\u201D\uFF09\u548C\u4EBA\u7C7B\u7F14\u7ED3\u4E86\u6DF1\u539A\u7684\u53CB\u8C0A\u548C\u548C\u5E73\u3002\u4ECA\u5929\u662F2114\u5E743\u670821\u65E5\uFF0C\u4E5F\u662F\u6211\u7684\u6BCD\u6821\u2014\u2014\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u2014\u2014\u7684100\u5468\u5E74\u6821\u5E86\u65E5\u3002\u5728\u6821\u5E86\u5178\u793C\u4E0A\uFF0C\u91D1\u9C7C\u8001\u5E08\u6B63\u5728\u5C55\u793A\u865A\u62DF\u73B0\u5B9E\u6E38\u620F\u8BBE\u8BA1\u8BFE\u7684\u5F80\u5C4A\u4F18\u79C0\u5B66\u751F\u4F5C\u54C1\uFF0C\u5C31\u5728\u8FD9\u65F6\u2026\u2026\u6211\u542C\u5230\u4E86\u5DE8\u5927\u7684\u7206\u70B8\u58F0\uFF01\u7136\u540E\uFF0C\u6211\u5C31\u6655\u4E86\u8FC7\u53BB\u2026\u2026\u5F53\u6211\u9192\u6765\u65F6\uFF0C\u7ADF\u53D1\u73B0\u5B66\u6821\u53D8\u6210\u4E86\u4E00\u7247\u5E9F\u589F\uFF0C\u56DB\u5468\u8FD8\u6E38\u8361\u8FD9\u8BB8\u591A\u51F6\u6076\u7684\u54C8\u57FA\u7C73\u6D77\u76D7\uFF01\u6765\u4E0D\u53CA\u591A\u60F3\uFF0C\u6211\u53EA\u80FD\u62FF\u8D77\u6389\u843D\u5728\u8EAB\u65C1\u7684\u6B66\u5668\u4FDD\u536B\u81EA\u5DF1\uFF01\r\nabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ,./:;'\"!`~\r\nUI-\u4E3B\u83DC\u5355\uFF1A\u6807\u9898\uFF1A\u54C8\u57FA\u7C73\u8DE8\u65F6\u7A7A\u884C\u52A8\uFF1B\u6309\u94AE\uFF1A\u5F00\u59CB\u6E38\u620F\u7A7F\u8D8A\u7EE7\u7EED\u9000\u51FA\u56FE\u9274\u8BBE\u7F6E\u9009\u62E9\u8BED\u8A00\u7B80\u4F53\u4E2D\u6587\u65E5\u672C\r\n\u65E5\u672C\u8A9E\u3042\u3044\u3046\u3048\u304A\u304B\u304D\u304F\u3051\u3053\u3055\u3057\u3059\u305B\u305D\u305F\u3061\u3064\u3066\u3068\r\n\u306A\u306B\u306C\u306D\u306E\u306F\u3072\u3075\u3078\u307B\u307E\u307F\u3080\u3081\u3082\u3084\u3086\u3088\u3089\u308A\u308B\u308C\u308D\u308F\u3092\u79C1\r\n\u3060\u3062\u3065\u3067\u3069\u304C\u304E\u3050\u3052\u3054\u3056\u3058\u305A\u305C\u305E\u3070\u3073\u3076\u3079\u307C\u3093\r\n\u3071\u3074\u3077\u307A\u307D\r\n\r\n\u56FE\u9274\u7CFB\u7EDF\uFF1A\r\n\u6D77\u85FB\u7CFB\u7EDF\u56FE\u9274\u7EC8\u7AEF\uFF1A\u6B22\u8FCE\u6765\u5230\u7EC8\u7AEF\uFF0C\u672C\u7EC8\u7AEF\u7531\u559C\u6B22\u6E38\u620F\u7684\u4EBA\u5DE5\u667A\u80FD\u6D77\u85FB\u5F00\u53D1\uFF0C\u65E8\u5728\u6FC0\u52B1\u4F7F\u7528\u8005\u4E0D\u65AD\u63A2\u7D22\u3001\u53D1\u73B0\u65B0\u4E8B\u7269\u3002\u795D\u60A8\u4F7F\u7528\u6109\u5FEB\uFF01\r\n\r\n\u89D2\u8272\u7B80\u4ECB\uFF1A\r\n\u674E\u561F\u561F\uFF0C\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u7684\u65F6\u95F4\u4FE1\u606F\u5DE5\u7A0B\u4E13\u4E1A\u5B66\u751F\uFF0C\u64C5\u957F\u4F7F\u7528\u79D1\u6280\u7C7B\u6B66\u5668\u3002\r\n\u8BF8\u845B\u597D\u5E05\uFF0C\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u7684\u4E2D\u56FD\u53E4\u5178\u6CD5\u672F\u4E13\u4E1A\u5B66\u751F\uFF0C\u64C5\u957F\u4F7F\u7528\u6CD5\u672F\u7C7B\u6B66\u5668\u3002\r\n\u8C1C\u5965\uFF0C\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u7684\u91CF\u5B50\u7269\u7406\u4E13\u4E1A\u5B66\u751F\uFF0C\u6765\u81EA\u66FC\u6CE2\u661F\u7403\u7684\u795E\u79D8\u4EA4\u6D41\u751F\u3002\r\n\u89D2\u8272\u672A\u89E3\u9501\uFF01\u5B8C\u6210\u7279\u5B9A\u4EFB\u52A1\u4EE5\u89E3\u9501\u8BE5\u89D2\u8272\u3002\r\n\u9009\u62E9\u5173\u5361\uFF1A\r\n\u66FE\u7ECF\u7684\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\uFF0C\u5982\u4ECA\u53EA\u5269\u4E0B\u4E00\u7247\u65AD\u58C1\u6B8B\u57A3\uFF0C\u548C\u56DB\u5904\u6E38\u8361\u3001\u7A77\u51F6\u6781\u6076\u7684\u6765\u81EA\u66FC\u6CE2\u661F\u7684\u54C8\u57FA\u7C73\u6D77\u76D7\u4EEC\u3002\r\n\u5173\u53612\uFF1A\u5E9F\u65E7\u56FE\u4E66\u9986 
      \u54E5\u7279\u5F0F\u7A79\u9876\u4E0E\u672A\u6765\u79D1\u6280\u6B8B\u9AB8\u4EA4\u7EC7\u7684\u5E9F\u589F\u56FE\u4E66\u9986\uFF0C\u66FE\u662F\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u6838\u5FC3\u77E5\u8BC6\u5723\u6BBF\uFF0C\u73B0\u4E3A\u54C8\u57FA\u7C73\u6D77\u76D7\u60C5\u62A5\u636E\u70B9\u3002\r\n\u7ED3\u7B97\u754C\u9762\uFF1A\u51FB\u8D25\u654C\u4EBA\u5B58\u6D3B\u65F6\u95F4\u6210\u529F\u5931\u8D25\r\n\r\n\u5347\u7EA7\u7CFB\u7EDF\uFF1A\u6700\u5927\u7ECF\u9A8C\u5F53\u524D\u8840\u91CF\u5269\u4F59\u654C\u602A\r\n\u6B66\u5668\u6570\u503C\uFF1A\u4F24\u5BB3\u51B7\u5374\u8303\u56F4\u5B50\u5F39\u66B4\u51FB\u7387\u6301\u7EED\u65F6\u95F4\u6570\u91CF\r\n\u6B66\u5668\u540D\u79F0\uFF1A\u521D\u53F7\u84DD\u8272\u5149\u5251\u6CD5\u6756\u5315\u9996\u5F13\u4E8C\u9879\u5F0F\u65A7\r\n\u666E\u901A\u7684\u6B65\u67AA\u3002\u674E\u561F\u561F\u5728\u6821\u56ED\u7684\u5E9F\u589F\u4E2D\u6361\u5230\u7684\u3002\u666E\u901A\u7684\u6CD5\u6756\r\n\u4F1A\u53D1\u5149\u7684\u5315\u9996\u91D1\u5C5E\u8D28\u611F\u7684\u5F13\u989C\u8272\u70AB\u9177\u7684\u65A7\u5934\u3002\r\n\u4ECA\u5929\u5403\u4E86\u4E94\u987F\u996D\r\n\u674E\u561F\u561F\uFF1A\r\n\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\uFF01\uFF1F\u5B66\u6821\u600E\u4E48\u4F1A\u53D8\u6210\u4E00\u7247\u5E9F\u589F\uFF01\uFF1F\u5176\u4ED6\u4EBA\u53C8\u90FD\u53BB\u54EA\u4E86\uFF1F\r\n\u521A\u624D\u597D\u50CF\u770B\u5230\u51E0\u4E2A\u54C8\u57FA\u7C73\u6D77\u76D7\uFF0C\u96BE\u9053\u662F\u4ED6\u4EEC\u88AD\u51FB\u4E86\u5B66\u6821\u2026\u2026\r\n\u53EF\u662F\uFF0C\u5730\u7403\u548C\u66FC\u6CE2\u661F\u4E0D\u662F\u4E00\u76F4\u4E00\u6765\u90FD\u662F\u548C\u5E73\u53CB\u597D\u7684\u5417\uFF1F\r\n\u5148\u4E0D\u60F3\u8FD9\u4E48\u591A\u4E86\uFF0C\u6211\u5F97\u4FDD\u62A4\u597D\u81EA\u5DF1\uFF01\u505C\u505C\u505C\uFF0C\u522B\u6253\u4E86\uFF01\u662F\u81EA\u5DF1\u4EBA\uFF01\r\n\u54A6\uFF1F\u6211\u597D\u50CF\u5728\u54EA\u89C1\u8FC7\u4F60\u3002\u90A3\u5F53\u7136\uFF0C\u56E0\u4E3A\u6211\u4EEC\u90FD\u662F\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u7684\u540C\u5B66\u5440\uFF01\r\n\u4E4B\u524D\u6211\u7A81\u7136\u542C\u89C1\u5DE8\u5927\u7684\u7206\u70B8\u58F0\uFF0C\u9192\u6765\u5C31\u53D1\u73B0\u6821\u56ED\u53D8\u6210\u4E86\u4E00\u7247\u5E9F\u589F\u2026\u2026\u6211\u4E5F\u662F\uFF01\u6211\u9192\u6765\u65F6\u53D1\u73B0\u8EAB\u65C1\u6709\u4E00\u4E2A\u7761\u7740\u4E86\u7684\u54C8\u57FA\u7C73\u6D77\u76D7\uFF0C\u6211\u5C31\u628A\u4ED6\u6253\u6655\u4E86\uFF0C\u6362\u4E0A\u4ED6\u7684\u8863\u670D\uFF0C\u6DF7\u5728\u6D77\u76D7\u4E2D\u4E86\u3002\r\n\u5947\u602A\u7684\u662F\uFF0C\u6211\u4ECE\u4ED6\u4EEC\u53E3\u4E2D\u542C\u8BF4\uFF0C\u4ECA\u5E74\u4F3C\u4E4E\u662F2111\u5E74\u2026\u20262111\u5E74\uFF1F\u90A3\u4E0D\u662F\u4E09\u5E74\u524D\u5417\uFF01\uFF1F\r\n\u6211\u518D\u6DF7\u5230\u6D77\u76D7\u91CC\u6253\u63A2\u6253\u63A2\u60C5\u62A5\uFF0C\u54B1\u4EEC\u56DE\u5934\u518D\u89C1\uFF01\u771F\u662F\u5947\u602A\u2026\u2026\r\n\uFF08\u674E\u561F\u561F\u5728\u7834\u635F\u7684\u884C\u653F\u697C\u8D70\u5ECA\u91CC\u6478\u7D22\uFF0C\u542C\u5230\u4E00\u95F4\u50A8\u85CF\u5BA4\u91CC\u4F20\u6765\u5FAE\u5F31\u7684\u547B\u541F\u3002\u5979\u8C28\u614E\u5730\u63A8\u5F00\u95E8\uFF0C\u53D1\u73B0\u4E00\u4F4D\u8EAB\u7740\u6CBE\u6EE1\u7070\u5C18\u7684\u7EF4\u4FEE\u5DE5\u5236\u670D\u7684\u4E2D\u5E74\u7537\u5B50\uFF0C\u4ED6\u7684\u817F\u90E8\u53D7\u4E86\u4F24\uFF0C\u7B80\u5355\u5305\u624E\u7740\u3002\uFF09\r\n\u8001\u534E\uFF1A\uFF08\u865A\u5F31\u5730\u62AC\u8D77\u5934\uFF0C\u773C\u795E\u4E2D\u5145\u6EE1\u8B66\u60D5\u4E0E\u7EDD\u671B\uFF09\u201C\u8C01\uFF1F\uFF01\u2026\u2026\u522B\u8FC7\u6765\uFF01\u90A3\u4E9B\u2018\u6D77\u76D7\u2019\u8FD8\u5728\u5916\u9762\u2026\u2026\u201D\r\n\u8001\u4F2F\uFF0C\u60A8\u522B\u6015\uFF0C\u6211\u662F\u5B66\u751F\uFF01\u5916\u9762\u2026\u2026\u5916\u9762\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F\u662F\u66FC\u6CE2\u661F\u4EBA\u5E72\u7684\u5417\uFF1F\r\n\uFF08\u82E6\u7B11\u4E00\u58F0\uFF0C\u54B3\u55FD\u7740\uFF09\u201C\u5B66\u751F\uFF1F\u4F60\u600E\u4E48\u4F1A\u5728\u8FD9\u2026\u2026\u5FEB\u8DD1\u5427\uFF0C\u5B69\u5B50\u3002\u8FD9\u6839\u672C\u4E0D\u662F\u6D77\u76D7\u88AD\u51FB\u2026\u2026\u6211\u770B\u5230\u4ED6\u4EEC\u7A7F\u7740\u6B63\u89C4\u519B\u7684\u88C5\u5907\uFF0C\u90A3\u5FBD\u8BB0\u2026\u2026\u662F\u66FC\u6CE2\u661F\u7684\u519B\u961F\u3002\u4ED6\u4EEC\u662F\u5728\u6709\u8BA1\u5212\u7684\u2026\u2026\u6293\u4EBA\u3001\u9500\u6BC1\u6587\u4EF6\u3002\u6211\u4EEC\u90FD\u88AB\u9A97\u4E86\uFF0C\u4EC0\u4E48\u548C\u5E73\u53CB\u597D\uFF0C\u5168\u662F\u5047\u7684\uFF01\r\n\u4ECA\u5E74\uFF0C\u662F2111\u5E74\u554A\uFF0C\u4E00\u4E2A\u5145\u6EE1\u707E\u96BE\u7684\u5E74\u4EFD\uFF01\r\n\uFF08\u8270\u96BE\u5730\u632A\u52A8\u8EAB\u4F53\uFF0C\u585E\u7ED9\u674E\u561F\u561F\u4E00\u5F20\u7834\u635F\u7684ID\u5361\uFF09\u62FF\u7740\u8FD9\u4E2A\uFF0C\u4E5F\u8BB8\u80FD\u6253\u5F00\u6863\u6848\u5BA4\u7684\u95E8\u2026\u2026\u627E\u5230\u771F\u76F8\u2026\u2026\u7136\u540E\u5FEB\u79BB\u5F00\u8FD9\uFF01\u522B\u50CF\u6211\u4E00\u6837\uFF0C\u56F0\u6B7B\u5728\u8FD9\u91CC\u2026\u2026\r\n\uFF08\u5728\u793C\u6587\u5802\u7684\u5E9F\u589F\u4E0B\uFF0C\u674E\u561F\u561F\u53D1\u73B0\u4E86\u4E00\u4E2A\u8737\u7F29\u5728\u8BB2\u53F0\u4E0B\u7684\u5C0F\u5973\u5B69\uFF0C\u6B63\u5BF9\u7740\u4E00\u4E2A\u7834\u635F\u7684\u54C8\u57FA\u7C73\u73A9\u5076\u4F4E\u58F0\u54ED\u6CE3\u3002\uFF09\r\n\uFF08\u53D7\u60CA\u5730\u62B1\u4F4F\u73A9\u5076\uFF09\u4E0D\u8981\u4F24\u5BB3\u6211\uFF01\u2026\u2026\u91CC\u6602\uFF0C\u6211\u6015\u2026\u2026\r\n\uFF08\u8E72\u4E0B\uFF09\u5C0F\u59B9\u59B9\uFF0C\u522B\u6015\uFF0C\u6211\u662F\u6765\u5E2E\u4F60\u7684\u3002\u91CC\u6602\u2026\u2026\u662F\u4F60\u7684\u670B\u53CB\u5417\uFF1F\r\n\uFF08\u6CEA\u6C34\u593A\u7736\u800C\u51FA\uFF09\u91CC\u6602\u662F\u6211\u6700\u597D\u7684\u670B\u53CB\u2026\u2026\u4ED6\u662F\u66FC\u6CE2\u661F\u7684\u4EA4\u6362\u751F\uFF0C\u6218\u4E89\u5F00\u59CB\u524D\uFF0C\u4ED6\u88AB\u4E00\u4E9B\u5730\u7403\u4EBA\u5F3A\u884C\u5E26\u8D70\u4E86\uFF0C\u4ED6\u4EEC\u8BF4\u4ED6\u662F\u5371\u9669\u7684\u5F02\u661F\u5206\u5B50\u2026\u2026\u53EF\u662F\u91CC\u6602\u4ED6\u4E00\u70B9\u90FD\u4E0D\u5371\u9669\uFF0C\u4ED6\u53EA\u662F\u60F3\u5BB6\uFF01\u4E3A\u4EC0\u4E48\u5927\u5BB6\u8981\u4E92\u76F8\u4F24\u5BB3\uFF1F\r\n\uFF08\u770B\u7740\u73A9\u5076\uFF0C\u5185\u5FC3\u77DB\u76FE\uFF09\u4EA4\u6362\u751F\u2026\u2026\u6240\u4EE5\uFF0C\u5728\u6218\u4E89\u7206\u53D1\u524D\uFF0C\u8FEB\u5BB3\u5C31\u5DF2\u7ECF\u5F00\u59CB\u4E86\uFF1F\r\n\uFF08\u7A81\u7136\u6293\u4F4F\u674E\u561F\u561F\u7684\u624B\uFF0C\u773C\u795E\u54C0\u6C42\uFF09\u59D0\u59D0\uFF0C\u4F60\u80FD\u627E\u5230\u91CC\u6602\u5417\uFF1F\u544A\u8BC9\u4ED6\u2026\u2026\u5C0F\u96C5\u4E0D\u602A\u4ED6\uFF0C\u5C0F\u96C5\u76F8\u4FE1\u548C\u5E73\u4E00\u5B9A\u4F1A\u56DE\u6765\u7684\u2026\u2026\r\n\uFF08\u674E\u561F\u561F\u5229\u7528\u8001\u534E\u7684ID\u5361\u8FDB\u5165\u4E86\u6838\u5FC3\u6570\u636E\u5BA4\uFF0C\u6210\u529F\u7834\u89E3\u4E86\u52A0\u5BC6\u670D\u52A1\u5668\uFF0C\u4E00\u6BB5\u6E05\u6670\u7684\u5185\u90E8\u901A\u8BAF\u8BB0\u5F55\u5F39\u51FA\u5728\u5C4F\u5E55\u4E0A\u3002\uFF09\r\n\u97F3\u9891\u8BB0\u5F55\r\n\u201C\u2026\u2026\u6E05\u626B\u884C\u52A8\u8FDB\u5165\u6700\u7EC8\u9636\u6BB5\u3002\u52A1\u5FC5\u6E05\u9664\u6240\u6709\u77E5\u60C5\u7684\u5730\u7403\u4EBA\u5458\uFF0C\u7279\u522B\u662F\u90A3\u4E9B\u4E0E\u65E9\u671F\u4EA4\u6362\u8BA1\u5212\u6709\u5173\u8054\u7684\u3002\u9999\u8549\u6E2F\u5927\u5B66\u7684\u2018\u610F\u5916\u2019\u5C06\u662F\u7ED3\u675F\u5730\u7403\u65B9\u9762\u65E0\u7406\u8BC9\u6C42\u7684\u6700\u7EC8\u65B9\u6848\u3002\u4E3A\u4E86\u66FC\u6CE2\u661F\u7684\u7EAF\u7CB9\u4E0E\u672A\u6765\uFF0C\u727A\u7272\u662F\u5FC5\u8981\u7684\u3002\u201D\r\n\uFF08\u96BE\u4EE5\u7F6E\u4FE1\u5730\u540E\u9000\u4E00\u6B65\uFF0C\u58F0\u97F3\u98A4\u6296\uFF09\u6240\u4EE5\u2026\u2026\u6240\u8C13\u7684\u2018\u653F\u53D8\u2019\uFF0C\u6839\u672C\u5C31\u662F\u4E00\u573A\u84C4\u8C0B\u5DF2\u4E45\u7684\u6E05\u6D17\uFF01\u4E3A\u4E86\u5DE9\u56FA\u6743\u529B\uFF0C\u4ED6\u4EEC\u4E0D\u60DC\u53D1\u52A8\u6218\u4E89\uFF0C\u8FDE\u81EA\u5DF1\u7684\u4EBA\u6C11\u90FD\u4E0D\u653E\u8FC7\u2026\u2026\r\n\uFF08\u674E\u561F\u561F\u521A\u521A\u4E0A\u4F20\u5B8C\u6570\u636E\uFF0C\u4E2A\u4EBA\u7EC8\u7AEF\u53D1\u51FA\u6025\u4FC3\u7684\u8B66\u62A5\uFF0C\u91D1\u9C7C\u8001\u5E08\u7684\u5168\u606F\u5F71\u50CF\u56E0\u4FE1\u53F7\u5E72\u6270\u800C\u5267\u70C8\u95EA\u70C1\u3002\uFF09\r\n\uFF08\u58F0\u97F3\u7126\u6025\u4E14\u4E25\u8083\uFF09\u561F\u561F\uFF01\u7ACB\u523B\u505C\u6B62\uFF01\u65F6\u7A7A\u4FE1\u6807\u68C0\u6D4B\u5230\u4F60\u6B63\u5728\u5C1D\u8BD5\u6539\u5199\u5DF2\u88AB\u56FA\u5B9A\u7684\u5386\u53F2\u8282\u70B9\uFF01\u542C\u7740\uFF0C\u6211\u77E5\u9053\u4F60\u60F3\u963B\u6B62\u8FD9\u573A\u60B2\u5267\uFF0C\u4F46\u6539\u53D8\u8FC7\u53BB\u7684\u4EE3\u4EF7\u662F\u2018\u65F6\u95F4\u6096\u8BBA\u2019\u7684\u5F7B\u5E95\u5D29\u6E83\uFF01\u4F60\u4F1A\u88AB\u629B\u51FA\u73B0\u6709\u65F6\u7A7A\u6D41\uFF0C\u53EF\u80FD\u2026\u2026\u6C38\u8FDC\u8FF7\u5931\u5728\u865A\u65E0\u4E4B\u4E2D\uFF0C\u6CA1\u6709\u4EBA\u80FD\u6551\u4F60\u56DE\u6765\uFF01\u73B0\u5728\u64A4\u56DE\u8FD8\u6765\u5F97\u53CA\uFF01\r\n\u8001\u5E08\uFF0C\u6211\u770B\u5230\u4E86\u771F\u76F8\u2026\u2026\u4E5F\u770B\u5230\u4E86\u56E0\u4E3A\u8C0E\u8A00\u800C\u727A\u7272\u7684\u4EBA\u3002\u5982\u679C\u660E\u77E5\u662F\u5BF9\u7684\u4E8B\u60C5\u5374\u56E0\u4E3A\u5BB3\u6015\u4EE3\u4EF7\u800C\u9000\u7F29\uFF0C\u90A3\u6211\u4EEC\u6240\u8FFD\u6C42\u7684\u2018\u771F\u5B9E\u2019\u53C8\u6709\u4EC0\u4E48\u610F\u4E49\uFF1F\r\n\u9009\u9879A\uFF1A\u516C\u4E4B\u4E8E\u4F17\uFF1A\u201C\u5373\u4F7F\u524D\u65B9\u662F\u6C38\u6052\u7684\u5B64\u72EC\uFF0C\u4E5F\u8981\u8BA9\u771F\u76F8\u7167\u4EAE\u5386\u53F2\u3002\u5C06\u8D44\u6599\u53D1\u9001\u81F3\u661F\u9645\u516C\u5171\u7F51\u7EDC\u3002\u201D\r\n\u9009\u9879B\uFF1A\u9EEF\u7136\u8FD4\u56DE\uFF1A\u201C\u6211\u2026\u2026\u8FD8\u4E0D\u80FD\u5728\u8FD9\u91CC\u7ED3\u675F\u3002\u5E26\u7740\u8BC1\u636E\u5B89\u5168\u8FD4\u56DE\u73B0\u4EE3\u3002\u201D
      \r\n\uFF08\u674E\u561F\u561F\u6DF1\u5438\u4E00\u53E3\u6C14\uFF0C\u6309\u4E0B\u4E86\u201C\u786E\u8BA4\u53D1\u9001\u201D\u952E\u3002\u6570\u636E\u6D41\u5982\u6D2A\u6D41\u822C\u6D8C\u5411\u661F\u9645\u7F51\u7EDC\u3002\u5979\u611F\u5230\u8EAB\u4F53\u9010\u6E10\u53D8\u5F97\u900F\u660E\uFF0C\u5468\u56F4\u7684\u4E16\u754C\u5F00\u59CB\u5D29\u89E3\u3002\u5728\u610F\u8BC6\u6D88\u6563\u7684\u6700\u540E\u65F6\u523B\uFF0C\u6E29\u6696\u7684\u56DE\u5FC6\u4E0E\u6218\u4E89\u7684\u8F70\u9E23\u4EA4\u7EC7\u5728\u4E00\u8D77\u3002\uFF09\r\n\uFF08\u610F\u8BC6\u6E38\u79BB\uFF0C\u58F0\u97F3\u8F7B\u4F46\u575A\u5B9A\uFF09\u201C\u6211\u770B\u5230\u2026\u2026\u6821\u56ED\u91CC\u7684\u6A31\u82B1\u53C8\u5F00\u4E86\u2026\u2026\u540C\u5B66\u4EEC\u5728\u9633\u5149\u4E0B\u7B11\u7740\u2026\u2026\u6211\u4E5F\u542C\u5230\u2026\u2026\u70AE\u706B\u58F0\u2026\u2026\u8D8A\u6765\u8D8A\u8FDC\u4E86\u2026\u2026\u6211\u505A\u5230\u4E86\u2026\u2026\u5BF9\u5417\uFF1F\u201D\r\n\uFF08\u5979\u7684\u8EAB\u5F71\u5B8C\u5168\u6D88\u6563\uFF0C\u800C\u661F\u9645\u7F51\u7EDC\u7684\u5404\u4E2A\u89D2\u843D\uFF0C\u5173\u4E8E\u771F\u76F8\u7684\u8BA8\u8BBA\u6B63\u4EE5\u524D\u6240\u672A\u6709\u7684\u901F\u5EA6\u7206\u53D1\u3002\u6E38\u620F\u7ED3\u675F\u65F6\uFF0C\u753B\u9762\u5B9A\u683C\u5728\u5386\u53F2\u6863\u6848\u4E2D\u88AB\u4FEE\u6B63\u7684\u3001\u8BB0\u8F7D\u7740\u8FD9\u573A\u9634\u8C0B\u7684\u9875\u9762\u3002\uFF09\r\n\uFF08\u674E\u561F\u561F\u98A4\u6296\u7740\u79FB\u5F00\u4E86\u624B\u6307\uFF0C\u9009\u62E9\u4E86\u201C\u53D6\u6D88\u201D\u3002\u5979\u542F\u52A8\u65F6\u5149\u673A\uFF0C\u5E26\u7740\u6C89\u91CD\u7684\u8BC1\u636E\u8FD4\u56DE\u3002\u5728\u719F\u6089\u7684\u5B9E\u9A8C\u5BA4\u91CC\uFF0C\u5979\u6CEA\u6D41\u6EE1\u9762\u5730\u762B\u5750\u5728\u5730\u3002\uFF09\r\n\uFF08\u5145\u6EE1\u6127\u759A\uFF09\u201C\u8001\u5E08\u2026\u2026\u6211\u2026\u2026\u6211\u662F\u4E2A\u9003\u5175\u3002\u6211\u672C\u53EF\u4EE5\u6551\u4ED6\u4EEC\u7684\u2026\u2026\u201D\r\n\u201C\u4E0D\uFF0C\u561F\u561F\u3002\u4F60\u4E0D\u662F\u9003\u5175\uFF0C\u4F60\u662F\u771F\u76F8\u7684\u89C1\u8BC1\u8005\u548C\u80CC\u8D1F\u8005\u3002\u4F60\u9009\u62E9\u4E86\u5C06\u5E0C\u671B\u7684\u79CD\u5B50\u5E26\u56DE\u6765\uFF0C\u5728\u672A\u6765\u8FD9\u7247\u66F4\u5E7F\u9614\u7684\u571F\u5730\u4E0A\uFF0C\u8BA9\u5B83\u751F\u6839\u53D1\u82BD\u3002\u8BA9\u727A\u7272\u8005\u7684\u610F\u5FD7\u5F97\u4EE5\u662D\u96EA\uFF0C\u8FD9\u540C\u6837\u9700\u8981\u5DE8\u5927\u7684\u52C7\u6C14\u3002\u6211\u4EEC\u56DE\u5BB6\u4E86\uFF0C\u800C\u771F\u6B63\u7684\u6218\u6597\uFF0C\u73B0\u5728\u624D\u521A\u521A\u5F00\u59CB\u3002\u201D\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u7684\u8EAB\u5F71\u5728\u65F6\u7A7A\u4E71\u6D41\u4E2D\u663E\u73B0\uFF0C\u4ED6\u73AF\u987E\u5DF2\u6210\u5E9F\u589F\u7684\u6821\u56ED\uFF0C\u9053\u888D\u5728\u785D\u70DF\u4E2D\u5FAE\u626C\u3002\uFF09\r\n\uFF08\u7709\u5934\u7D27\u9501\uFF0C\u4F4E\u58F0\u81EA\u8BED\uFF09\u201C\u65F6\u7A7A\u9006\u6D41\u7ADF\u5C06\u6211\u9001\u81F3\u5982\u6B64\u52AB\u540E\u4E4B\u5883\u2026\u2026\u55EF\uFF1F\u8FDC\u5904\u90A3\u4E9B\u8EAB\u5F71\uFF0C\u4F3C\u662F\u66FC\u6CE2\u661F\u7684\u2018\u54C8\u57FA\u7C73\u2019\uFF1F\u201D\r\n\uFF08\u4ED6\u624B\u6390\u6CD5\u8BC0\uFF0C\u8EAB\u5F62\u4E00\u9635\u6A21\u7CCA\uFF0C\u6613\u5BB9\u6210\u4E00\u540D\u54C8\u57FA\u7C73\u6D77\u76D7\u3002\uFF09\r\n\uFF08\u4EE5\u4F2A\u88C5\u540E\u7684\u58F0\u97F3\uFF0C\u51B7\u9759\u5730\u5206\u6790\uFF09\u201C\u5175\u8005\uFF0C\u8BE1\u9053\u4E5F\u3002\u5148\u884C\u9690\u533F\uFF0C\u89C2\u5176\u52A8\u5411\uFF0C\u65B9\u4E3A\u4E0A\u7B56\u3002\u201D\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u5728\u65AD\u5899\u540E\u56DE\u60F3\u8D77\u4E0E\u674E\u561F\u561F\u7684\u8BEF\u4F1A\u4EA4\u624B\u3002\uFF09\r\n\uFF08\u8F7B\u7B11\u6447\u5934\uFF0C\u89E3\u9664\u6613\u5BB9\uFF0C\u73B0\u51FA\u672C\u76F8\uFF09\u201C\u90A3\u83BD\u649E\u4E2B\u5934\uFF0C\u4E0D\u7531\u5206\u8BF4\u4FBF\u52A8\u624B\u2026\u2026\u5012\u4E5F\u60C5\u6709\u53EF\u539F\u3002\u8FD9\u8EAB\u6253\u626E\uFF0C\u786E\u6613\u5F15\u4EBA\u8BEF\u4F1A\u3002\u7F62\u4E86\uFF0C\u65E2\u5DF2\u7AA5\u5F97\u654C\u60C5\u4E00\u4E8C\uFF0C\u8FD8\u662F\u4EE5\u771F\u9762\u76EE\u884C\u4E8B\u66F4\u4E3A\u5766\u8361\u3002\u201D\r\n\uFF08\u5728\u7834\u635F\u7684\u4ED3\u5E93\uFF0C\u8BF8\u845B\u597D\u5E05\u9047\u89C1\u53D7\u4F24\u7684\u8001\u9773\u3002\uFF09\r\n\uFF08\u865A\u5F31\u800C\u8B66\u60D5\uFF09\u201C\u4F60\u2026\u2026\u4F60\u4E0D\u662F\u66FC\u6CE2\u661F\u4EBA\uFF1F\u4F60\u8FD9\u8EAB\u6253\u626E\u2026\u2026\u201D\r\n\uFF08\u8E72\u4E0B\u8EAB\uFF0C\u67E5\u770B\u5176\u4F24\u52BF\uFF0C\u8BED\u6C14\u5E73\u548C\uFF09\u201C\u8D2B\u9053\u8BF8\u845B\u597D\u5E05\uFF0C\u4E43\u65F6\u7A7A\u9519\u4E71\u81F3\u6B64\u3002\u8001\u4EBA\u5BB6\uFF0C\u6B64\u5730\u60E8\u72B6\uFF0C\u7A76\u7ADF\u7F18\u4F55\u800C\u8D77\uFF1F\u89C2\u90A3\u4E9B\u5175\u58EB\u884C\u5F84\uFF0C\u4F3C\u975E\u666E\u901A\u52AB\u63A0\u3002\u201D\r\n\uFF08\u54B3\u55FD\u7740\uFF0C\u9012\u8FC7\u4E00\u5F20\u901A\u884C\u5361\uFF09\u201C\u4ED6\u4EEC\u2026\u2026\u4ED6\u4EEC\u662F\u5728\u6709\u8BA1\u5212\u7684\u706D\u8FF9\uFF01\u62FF\u7740\u8FD9\u4E2A\uFF0C\u6211\u4ECE\u2026\u2026\u4E00\u4E2A\u66FC\u6CE2\u661F\u58EB\u5175\u8EAB\u4E0A\u2026\u2026\u6361\u5230\u7684\uFF0C\u6216\u6709\u7528\u2026\u2026\u771F\u76F8\uFF0C\u5C31\u5728\u66FC\u6CE2\u661F\u7684\u6218\u8230\u91CC\u2026\u2026\u201D\r\n\uFF08\u5728\u4E34\u65F6\u907F\u96BE\u6240\uFF0C\u8BF8\u845B\u597D\u5E05\u89C1\u5230\u6B63\u4E3A\u4E00\u540D\u53D7\u4F24\u58EB\u5175\u5305\u624E\u7684\u6167\u660E\u3002\u4ED6\u8EAB\u7740\u50E7\u888D\uFF0C\u795E\u60C5\u4E13\u6CE8\u800C\u5E73\u548C\u3002\uFF09\r\n\uFF08\u7709\u5934\u5FAE\u8E59\uFF0C\u8BED\u6C14\u5E26\u7740\u4E00\u4E1D\u5929\u5E08\u5E9C\u5B50\u5F1F\u56FA\u6709\u7684\u5028\u50B2\uFF09\u201C\u5567\uFF0C\u8FD9\u6218\u573A\u4E4B\u4E0A\uFF0C\u5200\u5251\u65E0\u773C\uFF0C\u5927\u5E08\u4E0D\u53BB\u6E05\u51C0\u5904\u8BF5\u7ECF\u7948\u798F\uFF0C\u6765\u6B64\u9669\u5730\uFF0C\u5C31\u4E0D\u6015\u4F5B\u6CD5\u65E0\u529B\uFF0C\u53CD\u53D7\u5176\u5BB3\u4E48\uFF1F\u201D\uFF08\u8BDD\u8BED\u4E2D\u900F\u9732\u51FA\u5BF9\u4F5B\u6CD5\u5728\u4E71\u4E16\u4E2D\u5B9E\u7528\u6027\u7684\u8F7B\u8511\u3002\uFF09\r\n\uFF08\u5E76\u672A\u62AC\u5934\uFF0C\u624B\u4E0A\u52A8\u4F5C\u4E0D\u505C\uFF0C\u58F0\u97F3\u6E29\u548C\u5374\u575A\u5B9A\uFF09\u201C\u963F\u5F25\u9640\u4F5B\u3002\u65BD\u4E3B\u7740\u76F8\u4E86\u3002\u4F5B\u4E0D\u5728\u5E99\u5802\uFF0C\u800C\u5728\u5FC3\u4E2D\u3002\u6148\u60B2\u4EA6\u975E\u7A7A\u8C08\uFF0C\u6B64\u523B\u80FD\u6B62\u4E00\u4EBA\u4E4B\u75DB\uFF0C\u80FD\u4E88\u4E00\u4EBA\u4E4B\u5B89\uFF0C\u4FBF\u662F\u65E0\u4E0A\u6CD5\u529B\uFF0C\u8FDC\u80DC\u4E8E\u5343\u767E\u904D\u7A7A\u6D1E\u7ECF\u6587\u3002\u201D\r\n\uFF08\u4ED6\u5305\u624E\u5B8C\u6BD5\uFF0C\u624D\u770B\u5411\u8BF8\u845B\u9753\uFF0C\u76EE\u5149\u6F84\u6F88\uFF09\u201C\u65BD\u4E3B\u975E\u5E38\u4EBA\uFF0C\u6B64\u523B\u73B0\u8EAB\uFF0C\u53EF\u662F\u5929\u610F\uFF1F\u7136\u5219\uFF0C\u4E0D\u8BBA\u9053\u6CD5\u4F5B\u6CD5\uFF0C\u82E5\u80FD\u6551\u4F17\u751F\u82E6\u5384\uFF0C\u4FBF\u662F\u6B63\u9053\u3002\u8D2B\u50E7\u867D\u529B\u8584\uFF0C\u4EA6\u613F\u5C3D\u7EF5\u529B\u3002\u201D\r\n\uFF08\u88AB\u6167\u660E\u7684\u4ECE\u5BB9\u548C\u7B03\u5B9A\u5FAE\u5FAE\u89E6\u52A8\uFF0C\u4F46\u50B2\u6C14\u672A\u6D88\uFF0C\u8F6C\u800C\u63D0\u51FA\u5B9E\u9645\u8BA1\u5212\uFF09\u201C\u2026\u2026\u5012\u662F\u4F36\u7259\u4FD0\u9F7F\u3002\u7F62\u4E86\uFF0C\u8D2B\u9053\u4E0D\u6B32\u5728\u6B64\u7A7A\u8C08\u8FA9\u6CD5\u3002\u6211\u6B32\u5F80\u654C\u519B\u6218\u8230\u4E00\u884C\uFF0C\u63A2\u5176\u6839\u672C\uFF0C\u4F60\u53EF\u6562\u540C\u5F80\uFF1F\u201D\r\n\uFF08\u53CC\u624B\u5408\u5341\uFF0C\u795E\u8272\u65E0\u60E7\uFF09\u201C\u6211\u4E0D\u5165\u5730\u72F1\uFF0C\u8C01\u5165\u5730\u72F1\uFF1F\u65BD\u4E3B\u82E5\u5F80\uFF0C\u8D2B\u50E7\u613F\u540C\u53BB\uFF0C\u6216\u53EF\u7565\u5C3D\u7EF5\u529B\uFF0C\u4EE5\u8BC1\u6211\u4F5B\u95E8\u4EA6\u975E\u53EA\u4F1A\u7A7A\u8C08\u3002\u201D\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u4E0E\u6167\u660E\u6F5C\u5165\u66FC\u6CE2\u661F\u6218\u8230\uFF0C\u53D1\u73B0\u4E8C\u628A\u624B\u501F\u653F\u53D8\u6E05\u9664\u5F02\u5DF1\u3001\u5E76\u610F\u56FE\u524A\u5F31\u5730\u7403\u7684\u673A\u5BC6\u3002\uFF09\r\n\uFF08\u5FEB\u901F\u6D4F\u89C8\u6570\u636E\uFF0C\u9707\u60CA\uFF09\u201C\u597D\u4E00\u62DB\u4E00\u77F3\u4E8C\u9E1F\u4E4B\u8BA1\uFF01\u7ADF\u8FDE\u81EA\u5DF1\u4EBA\u4E5F\u2026\u2026\u201D\uFF08\u8B66\u62A5\u54CD\u8D77\uFF0C\u8FFD\u5175\u5C06\u81F3\u3002\uFF09\r\n\uFF08\u731B\u5730\u5C06\u5B58\u50A8\u6838\u5FC3\u585E\u5165\u8BF8\u845B\u9753\u624B\u4E2D\uFF0C\u7528\u5C3D\u5168\u529B\u5C06\u4ED6\u63A8\u5411\u7D27\u6025\u9003\u751F\u901A\u9053\uFF0C\u81EA\u5DF1\u5219\u8F6C\u8EAB\u6321\u5728\u552F\u4E00\u7684\u51FA\u53E3\u524D\uFF0C\u8EAB\u6CDB\u67D4\u548C\u5374\u575A\u5B9A\u7684\u4F5B\u5149\uFF09\u201C\u8BF8\u845B\u65BD\u4E3B\uFF0C\u5E26\u7740\u771F\u76F8\u5FEB\u8D70\uFF01\u73B0\u5728\u4F60\u660E\u767D\u4E86\uFF0C\u771F\u6B63\u7684\u654C\u4EBA\u5E76\u975E\u6218\u573A\u4E0A\u7684\u58EB\u5175\uFF0C\u800C\u662F\u8FD9\u80CC\u540E\u7684\u8D2A\u5A6A\u4E0E\u8C0E\u8A00\u3002\u771F\u76F8\u662D\u793A\uFF0C\u4FBF\u662F\u65E0\u91CF\u529F\u5FB7\uFF0C\u4F55\u987B\u6267\u7740\u4E8E\u8C01\u4EBA\u53BB\u4E3A\uFF1F\u5FEB\u8D70\uFF01\u201D\r\n\uFF08\u76EE\u7726\u6B32\u88C2\uFF0C\u8BD5\u56FE\u62C9\u56DE\u6167\u660E\uFF09\u201C\u548C\u5C1A\uFF01\u4F60\u75AF\u4E86\uFF01\u4F60\u6321\u4E0D\u4F4F\u4ED6\u4EEC\u7684\uFF01\u8DDF\u6211\u4E00\u8D77\u8D70\uFF01\u201D
      \r\n\uFF08\u7ED3\u5370\u800C\u7ACB\uFF0C\u56DE\u5934\u5BF9\u8BF8\u845B\u9753\u9732\u51FA\u4E00\u4E2A\u91CA\u7136\u7684\u5FAE\u7B11\uFF0C\u4F5B\u5149\u66F4\u76DB\uFF09\u201C\u65BD\u4E3B\uFF0C\u8BB0\u5F97\u8D2B\u50E7\u7684\u8BDD\u5417\uFF1F\u4F5B\u6CD5\u4EA6\u80FD\u62A4\u4EBA\u3002\u6E21\u4F60\uFF0C\u4FBF\u662F\u6E21\u4E07\u5343\u4F17\u751F\u3002\u6B64\u4E43\u6211\u9053\uFF0C\u671B\u4F60\u2026\u2026\u8BC1\u5F97\u5DF1\u9053\u3002\u201D\uFF08\u8BDD\u97F3\u672A\u843D\uFF0C\u80FD\u91CF\u5149\u675F\u5DF2\u6DF9\u6CA1\u4ED6\u7684\u8EAB\u5F71\u3002\uFF09\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u542B\u6CEA\u7A81\u56F4\uFF0C\u624B\u4E2D\u6570\u636E\u677F\u707C\u70ED\uFF0C\u8033\u8FB9\u56DE\u54CD\u7740\u6167\u660E\u6700\u540E\u7684\u8BDD\u8BED\uFF0C\u5185\u5FC3\u53D7\u5230\u524D\u6240\u672A\u6709\u7684\u9707\u64BC\u4E0E\u6D17\u793C\u3002\uFF09\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u542F\u52A8\u65F6\u5149\u673A\uFF0C\u91D1\u9C7C\u8001\u5E08\u5168\u606F\u5F71\u50CF\u51FA\u73B0\u3002\uFF09\r\n\uFF08\u8BED\u6C14\u6025\u4FC3\u4E25\u8083\uFF09\u201C\u8BF8\u845B\u597D\u5E05\uFF01\u5207\u52FF\u51B2\u52A8\uFF01\u65F6\u7A7A\u6096\u8BBA\u7684\u53CD\u566C\u975E\u540C\u5C0F\u53EF\uFF0C\u5F3A\u884C\u6539\u53D8\u65E2\u5B9A\u5386\u53F2\u8282\u70B9\uFF0C\u4F60\u6781\u6709\u53EF\u80FD\u88AB\u65F6\u7A7A\u4E71\u6D41\u541E\u566C\uFF0C\u6C38\u4E16\u98D8\u96F6\uFF01\u201D\r\n\uFF08\u624B\u63E1\u5B58\u50A8\u6838\u5FC3\uFF0C\u773C\u524D\u95EA\u8FC7\u6167\u660E\u727A\u7272\u7684\u573A\u666F\u548C\u6C11\u4F17\u7684\u82E6\u96BE\uFF0C\u5185\u5FC3\u6FC0\u70C8\u6323\u624E\uFF09\u201C\u8001\u5E08\uFF0C\u6167\u660E\u5927\u5E08\u4E3A\u771F\u76F8\u820D\u8EAB\uFF0C\u4E07\u5343\u751F\u7075\u56E0\u9634\u8C0B\u6D82\u70AD\u2026\u2026\u82E5\u6B64\u65F6\u9000\u7F29\uFF0C\u543E\u4E4B\u9053\u5FC3\uFF0C\u5C06\u6C38\u8499\u5C18\u57C3\u3002\u201D\r\n\u9009\u9879A\uFF1A\u516C\u4E4B\u4E8E\u4F17\uFF1A\u201C\u867D\u4E07\u5343\u4EBA\u543E\u5F80\u77E3\uFF0C\u613F\u627F\u5929\u9053\uFF0C\u662D\u793A\u771F\u76F8\u3002\u201D\r\n\u9009\u9879B\uFF1A\u9EEF\u7136\u8FD4\u56DE\uFF1A\u201C\u6682\u907F\u5176\u950B\uFF0C\u5F90\u56FE\u540E\u8BA1\u3002\u201D\r\n\uFF08\u8BF8\u845B\u597D\u5E05\u9009\u62E9\u516C\u5F00\u771F\u76F8\u3002\u4F46\u4ED6\u5E76\u672A\u88AB\u65F6\u7A7A\u4E71\u6D41\u541E\u566C\uFF0C\u800C\u662F\u9762\u9732\u5FAE\u7B11\uFF0C\u5468\u8EAB\u9053\u6CD5\u81EA\u7136\u6D41\u8F6C\u3002\uFF09\uFF08\u795E\u6001\u5E73\u548C\uFF0C\u795E\u8BC6\u4E0E\u5929\u5730\u5171\u9E23\uFF09\u201C\u6167\u660E\u5927\u5E08\u4EE5\u820D\u8EAB\u8BC1\u6148\u60B2\uFF0C\u8D2B\u9053\u4ECA\u65E5\uFF0C\u4FBF\u4EE5\u8FD9\u8EAB\u4FEE\u4E3A\uFF0C\u5316\u5929\u9053\u4F20\u97F3\uFF0C\u5C06\u771F\u76F8\u70D9\u5370\u4E8E\u4F17\u751F\u5FC3\u95F4\u3002\u6B64\u975E\u5F3A\u884C\u6539\u547D\uFF0C\u4E43\u662F\u64AD\u4E0B\u89C9\u609F\u4E4B\u79CD\u3002\u4E07\u7269\u8D1F\u9634\u800C\u62B1\u9633\uFF0C\u51B2\u6C14\u4EE5\u4E3A\u548C\u2026\u2026\u5929\u4E0B\u5927\u540C\uFF0C\u65B9\u4E3A\u6B63\u9053\u3002\u201D\r\n\uFF08\u4ED6\u7684\u8EAB\u5F62\u5316\u4E3A\u70B9\u70B9\u5149\u534E\uFF0C\u878D\u5165\u5929\u5730\uFF0C\u4E00\u6BB5\u8574\u542B\u771F\u76F8\u7684\u610F\u8BC6\u6CE2\u52A8\u6E29\u67D4\u5374\u4E0D\u53EF\u6297\u62D2\u5730\u4F20\u904D\u661F\u9645\u3002\uFF09\uFF08\u8BF8\u845B\u597D\u5E05\u9009\u62E9\u8FD4\u56DE\u3002\u5B9E\u9A8C\u5BA4\u4E2D\uFF0C\u4ED6\u795E\u8272\u6C89\u91CD\u3002\uFF09\r\n\uFF08\u5BF9\u91D1\u9C7C\u8001\u5E08\u4E00\u63D6\uFF0C\u8BED\u6C14\u6C89\u75DB\u800C\u575A\u5B9A\uFF09\u201C\u8001\u5E08\uFF0C\u5F1F\u5B50\u56DE\u6765\u4E86\u3002\u975E\u662F\u8D2A\u751F\uFF0C\u5B9E\u4E43\u609F\u5F97\u6167\u660E\u5927\u5E08\u727A\u7272\u4E4B\u6DF1\u610F\u2014\u2014\u771F\u76F8\u9700\u5584\u7528\u4EE5\u8B66\u4E16\uFF0C\u800C\u975E\u5F92\u7136\u6B89\u4E4B\u3002\u5F1F\u5B50\u613F\u7EE7\u627F\u5927\u5E08\u4E4B\u5FD7\uFF0C\u4EE5\u6B64\u8BC1\u636E\uFF0C\u5BFB\u6C42\u7EC8\u7ED3\u4EC7\u6068\u3001\u5BFC\u5411\u771F\u6B63\u548C\u5E73\u4E4B\u9053\u3002\u6B64\u756A\u7ECF\u5386\uFF0C\u8BA9\u5F1F\u5B50\u660E\u767D\uFF0C\u4E0A\u5584\u82E5\u6C34\uFF0C\u5316\u89E3\u5E72\u6208\uFF0C\u8FDC\u80DC\u4E8E\u4EE5\u6740\u6B62\u6740\u3002\u201D\r\n\u8C1C\u5965\xB7\u79D2\u63CF\u9088\uFF1A\r\n\uFF08\u5DE8\u5927\u7684\u7206\u70B8\u58F0\u6495\u88C2\u4E86\u5B9E\u9A8C\u5BA4\u7684\u5B81\u9759\uFF0C\u65F6\u7A7A\u4E71\u6D41\u5982\u540C\u7EDA\u70C2\u800C\u5371\u9669\u7684\u6F29\u6DA1\u822C\u5C55\u5F00\u3002\u8C1C\u5965\u77EB\u5065\u5730\u4ECE\u85CF\u8EAB\u5904\u8DC3\u51FA\uFF0C\u773C\u795E\u4E2D\u5145\u6EE1\u51B3\u7EDD\u3002\uFF09\r\n\uFF08\u6BEB\u4E0D\u72B9\u8C6B\u5730\u51B2\u5411\u4E71\u6D41\u4E2D\u5FC3\uFF09\u201C\u5C31\u662F\u73B0\u5728\uFF01\u7238\u7238\u5988\u5988\u2026\u2026\u65E0\u8BBA\u4F60\u4EEC\u5728\u54EA\u91CC\uFF0C\u8FD9\u4E00\u6B21\uFF0C\u6211\u7EDD\u4E0D\u4F1A\u518D\u5931\u53BB\u4F60\u4EEC\uFF01\u201D\r\n\uFF08\u4ED6\u88AB\u4E71\u6D41\u541E\u566C\uFF0C\u4E00\u9635\u5929\u65CB\u5730\u8F6C\u540E\uFF0C\u91CD\u91CD\u6454\u843D\u5728\u719F\u6089\u53C8\u964C\u751F\u7684\u6821\u56ED\u3002\u785D\u70DF\u5F25\u6F2B\uFF0C\u65AD\u58C1\u6B8B\u57A3\u3002\uFF09\r\n\uFF08\u6447\u6643\u7740\u7AD9\u8D77\u8EAB\uFF0C\u5C3D\u7BA1\u5468\u906D\u6218\u706B\u7EB7\u98DE\uFF0C\u5979\u7684\u8138\u4E0A\u5374\u7EFD\u653E\u51FA\u72C2\u559C\u7684\u7B11\u5BB9\uFF0C\u773C\u6CEA\u5728\u773C\u7736\u4E2D\u6253\u8F6C\uFF09\u201C\u6210\u529F\u4E86\u2026\u2026\u6211\u771F\u7684\u56DE\u6765\u4E86\uFF01\u8FD9\u4E2A\u65F6\u95F4\u70B9\u2026\u2026\u6CA1\u9519\uFF0C\u4ED6\u4EEC\u8FD8\u5728\u8FD9\u91CC\uFF0C\u8FD8\u6D3B\u7740\uFF01\u6211\u5FC5\u987B\u9A6C\u4E0A\u627E\u5230\u4ED6\u4EEC\uFF01\u201D\r\n\uFF08\u51E0\u540D\u66FC\u6CE2\u661F\u58EB\u5175\u53D1\u73B0\u4E86\u8C1C\u5965\uFF0C\u4E0D\u7531\u5206\u8BF4\u5730\u53D1\u8D77\u4E86\u653B\u51FB\u3002\u8C1C\u5965\u72FC\u72C8\u5730\u8EB2\u95EA\u7740\uFF0C\u6EE1\u8138\u7684\u96BE\u4EE5\u7F6E\u4FE1\u3002\uFF09\r\n\uFF08\u4E00\u8FB9\u95EA\u907F\uFF0C\u4E00\u8FB9\u7126\u6025\u5730\u5927\u558A\uFF09\u201C\u4F4F\u624B\uFF01\u6211\u662F\u66FC\u6CE2\u661F\u4EBA\uFF01\u4F60\u4EEC\u4E3A\u4EC0\u4E48\u8981\u653B\u51FB\u6211\uFF1F\u6211\u4EEC\u4E0D\u662F\u6765\u5E2E\u52A9\u5730\u7403\u7EF4\u6301\u548C\u5E73\u7684\u5417\uFF1F\u201D\r\n\uFF08\u653B\u51FB\u5E76\u672A\u505C\u6B62\uFF0C\u53CD\u800C\u66F4\u52A0\u731B\u70C8\u3002\u8C1C\u5965\u7684\u773C\u795E\u4ECE\u56F0\u60D1\u9010\u6E10\u53D8\u4E3A\u9510\u5229\u3002\uFF09\r\n\uFF08\u4F4E\u58F0\u81EA\u8BED\uFF0C\u5185\u5FC3\u5267\u9707\uFF09\u201C\u4E0D\u5BF9\u2026\u2026\u8FD9\u6839\u672C\u4E0D\u662F\u7EF4\u548C\u884C\u52A8\uFF0C\u8FD9\u662F\u5C60\u6740\uFF01\u6240\u8C13\u7684\u2018\u653F\u53D8\u2019\u80CC\u540E\uFF0C\u4E00\u5B9A\u6709\u66F4\u5927\u7684\u9634\u8C0B\u2026\u2026\u6211\u5FC5\u987B\u5F04\u6E05\u695A\u771F\u76F8\uFF0C\u5426\u5219\u7236\u6BCD\u5C31\u767D\u6B7B\u4E86\uFF01\u4ED6\u4EEC\u8FD9\u4E2A\u65F6\u5019\u2026\u2026\u5E94\u8BE5\u8FD8\u5728\u5927\u5B66\u7684\u4E34\u65F6\u5E87\u62A4\u6240\uFF01\u201D\r\n\uFF08\u8C1C\u5965\u5229\u7528\u9AD8\u8D85\u7684\u6F5C\u884C\u6280\u5DE7\u548C\u672A\u6765\u77E5\u8BC6\uFF0C\u6084\u7136\u6F5C\u5165\u66FC\u6CE2\u661F\u6307\u6325\u8230\uFF0C\u5077\u542C\u5230\u4E86\u4E8C\u628A\u624B\u7684\u901A\u8BAF\u3002\uFF09\r\n\u201C\u2026\u2026\u7B49\u4E8B\u60C5\u7ED3\u675F\uFF0C\u6240\u6709\u53C2\u4E0E\u8FD9\u6B21\u884C\u52A8\u7684\u58EB\u5175\uFF0C\u4EE5\u53CA\u90A3\u4E9B\u8FD8\u7559\u5728\u9999\u8549\u6E2F\u7684\u2018\u7D2F\u8D58\u2019\u5B66\u751F\uFF0C\u5168\u90E8\u5904\u7406\u6389\u3002\u7EDD\u4E0D\u80FD\u7559\u4E0B\u4EFB\u4F55\u6D3B\u53E3\uFF0C\u4E0D\u80FD\u8BA9\u4EFB\u4F55\u4EBA\u77E5\u9053\u662F\u6211\u4EEC\u4E3B\u52A8\u6311\u8D77\u7684\u6218\u4E89\u3002\u8981\u628A\u6240\u6709\u8D23\u4EFB\u90FD\u63A8\u5230\u5730\u7403\u4EBA\u5934\u4E0A\uFF0C\u662F\u4ED6\u4EEC\u2018\u6B8B\u5FCD\u2019\u5730\u6740\u5BB3\u4E86\u6211\u4EEC\u7684\u4EBA\u6C11\uFF0C\u8FD9\u6837\u624D\u80FD\u6FC0\u8D77\u5168\u56FD\u7684\u6012\u706B\uFF0C\u4E3A\u6211\u63A5\u4E0B\u6765\u7684\u8BA1\u5212\u94FA\u8DEF\u2026\u2026\u201D\r\n\uFF08\u5982\u906D\u96F7\u51FB\uFF0C\u762B\u8F6F\u5728\u9690\u853D\u5904\uFF0C\u8138\u8272\u60E8\u767D\uFF0C\u58F0\u97F3\u98A4\u6296\u5F97\u51E0\u4E4E\u65E0\u6CD5\u51FA\u58F0\uFF09\u201C\u4E0D\u2026\u2026\u8FD9\u4E0D\u53EF\u80FD\u2026\u2026\u6211\u4E00\u76F4\u4EE5\u4E3A\uFF0C\u662F\u5730\u7403\u4EBA\u7684\u8D2A\u5A6A\u5BB3\u6B7B\u4E86\u4F60\u4EEC\u2026\u2026\u539F\u6765\u2026\u2026\u539F\u6765\u6211\u4EEC\u624D\u662F\u88AB\u81EA\u5DF1\u4EBA\u80CC\u53DB\u7684\u68CB\u5B50\u2026\u2026\u6211\u7ADF\u7136\u6068\u9519\u4E86\u4EBA\u8FD9\u4E48\u591A\u5E74\u2026\u2026\u201D\r\n\uFF08\u8C1C\u5965\u6362\u4E0A\u6D77\u76D7\u670D\uFF0C\u6DF7\u5165\u4EBA\u7FA4\uFF0C\u7EC8\u4E8E\u627E\u5230\u4E86\u7236\u6BCD\u6240\u5728\u7684\u8425\u5E10\u3002\uFF09\uFF08\u51B2\u8FDB\u8425\u5E10\uFF0C\u626F\u4E0B\u4F2A\u88C5\uFF0C\u58F0\u97F3\u54FD\u54BD\uFF09\u201C\u7238\uFF01\u5988\uFF01\u201D\r\n\uFF08\u9707\u60CA\u5730\u770B\u7740\u8FD9\u4E2A\u7A81\u7136\u51FA\u73B0\u7684\u3001\u4E0E\u81EA\u5DF1\u513F\u5B50\u5BB9\u8C8C\u76F8\u4F3C\u7684\u964C\u751F\u4EBA\uFF09\u201C\u4F60\u662F\u2026\u2026\uFF1F\u201D\r\n\uFF08\u6CEA\u6C34\u593A\u7736\u800C\u51FA\uFF09\u201C\u662F\u6211\uFF01\u6211\u662F\u4ECE\u672A\u6765\u56DE\u6765\u7684\uFF01\u542C\u7740\uFF0C\u8FD9\u573A\u6218\u4E89\u662F\u4E2A\u9A97\u5C40\uFF01\u66FC\u6CE2\u661F\u7684\u4E8C\u628A\u624B\u8981\u6740\u4F60\u4EEC\u706D\u53E3\uFF01\u5FEB\u8DDF\u6211\u8D70\uFF01\u201D\r\n\uFF08\u867D\u7136\u7591\u60D1\uFF0C\u4F46\u770B\u7740\u8C1C\u5965\u773C\u4E2D\u65E0\u6BD4\u771F\u5B9E\u7684\u75DB\u82E6\u4E0E\u7126\u6025\uFF0C\u4E0E\u4E08\u592B\u5BF9\u89C6\u4E00\u773C\u540E\uFF0C\u575A\u5B9A\u5730\u70B9\u5934\uFF09\u201C\u6211\u4EEC\u76F8\u4FE1\u4F60\uFF01\u5B69\u5B50\uFF0C\u65E0\u8BBA\u4F60\u4ECE\u54EA\u6765\uFF0C\u4F60\u773C\u4E2D\u7684\u5173\u5207\u4E0D\u662F\u5047\u7684\u3002\u201D\r\n\uFF08\u6B64\u65F6\uFF0C\u5E10\u5916\u4F20\u6765\u8FFD\u5175\u7684\u811A\u6B65\u58F0\u548C\u53EB\u558A\u58F0\u3002\uFF09\uFF08\u8C1C\u5965\u5E26\u7740\u7236\u6BCD\u8EB2\u8FDB\u6821\u957F\u529E\u516C\u5BA4\uFF0C\u5728\u6563\u843D\u7684\u6587\u4EF6\u4E2D\u53D1\u73B0\u4E86\u5730\u7403\u65B9\u7684\u79D8\u5BC6\u8BA1\u5212\u3002\uFF09\r\n\uFF08\u8BFB\u7740\u6587\u4EF6\uFF0C\u58F0\u97F3\u91CC\u5145\u6EE1\u8352\u8BDE\u611F\uFF09\u201C\u2026\u2026\u717D\u52A8\u60C5\u7EEA\uFF0C\u9F13\u52B1\u2018\u81EA\u536B\u2019\uFF0C\u5C3D\u53EF\u80FD\u591A\u5730\u6E05\u9664\u5728\u6E2F\u66FC\u6CE2\u5B66\u751F\uFF0C\u4EE5\u2018\u524A\u5F31\u5176\u672A\u6765\u6F5C\u529B\u2019\u2026\u2026\u5475\u5475\uFF0C\u54C8\u54C8\u2026\u2026\u771F\u53EF\u7B11\u554A\uFF01\u66FC\u6CE2\u661F\u5728\u6E05\u9664\u2018\u77E5\u60C5\u8005\u2019\uFF0C\u5730\u7403\u5728\u8BA1\u5212\u2018\u672A\u6765\u4FB5\u7565\u2019\u2026\u2026\u4E24\u4E2A\u661F\u7403\u7684\u9886\u5BFC\u8005\uFF0C\u90FD\u5728\u7528\u666E\u901A\u4EBA\u7684\u8840\u4E3A\u81EA\u5DF1\u94FA\u8DEF\uFF01\u201D\r\n\uFF08\u4ED6\u65E0\u529B\u5730\u5750\u5012\u5728\u5730\uFF0C\u773C\u795E\u7A7A\u6D1E\uFF09\u201C\u6211\u8BE5\u6068\u8C01\uFF1F\u517B\u80B2\u6211\u7684\u6BCD\u661F\u8981\u6740\u6211\u7236\u6BCD\uFF0C\u6211\u672C\u8BE5\u4EC7\u6068\u7684\u5730\u7403\u4E5F\u540C\u6837\u80AE\u810F\u2026\u2026\u6211\u5230\u5E95\u8BE5\u4E3A\u4EC0\u4E48\u800C\u6218\uFF1F\r\n\uFF08\u8FFD\u5175\u7834\u95E8\u800C\u5165\u3002\u5173\u952E\u65F6\u523B\uFF0C\u91D1\u9C7C\u8001\u5E08\u7684\u901A\u8BAF\u63A5\u5165\u3002\uFF09\r\n\uFF08\u5168\u606F\u5F71\u50CF\u6025\u5207\u5730\uFF09\u201C\u8C1C\u5965\uFF01\u65F6\u7A7A\u7ED3\u6784\u6781\u5EA6\u4E0D\u7A33\u5B9A\uFF01\u5982\u679C\u4F60\u5F3A\u884C\u6539\u53D8\u4F60\u7236\u6BCD\u7684\u547D\u8FD0\uFF0C\u6096\u8BBA\u7684\u53CD\u566C\u5F88\u53EF\u80FD\u8BA9\u4F60\u6211\u90FD\u6D88\u5931\uFF01\u5FEB\u505A\u51B3\u5B9A\uFF01\u201D\r\n\uFF08\u5728\u6551\u7236\u6BCD\u4E0E\u7EF4\u6301\u65F6\u7A7A\u7A33\u5B9A\u7684\u4E24\u96BE\u4E2D\u75DB\u82E6\u6323\u624E\uFF09\u201C\u6211\u2026\u2026\u201D\u9009\u9879A\uFF1A\u6551\u52A9\u7236\u6BCD\uFF08\u540E\u89C1\u5982\u4E0B\uFF09\r\n\u9009\u9879B\uFF1A\u72B9\u8C6B\uFF08\u540E\u89C1\u5982\u4E0B\uFF09\r\n\uFF08\u8BED\u901F\u6781\u5FEB\uFF0C\u773C\u795E\u51B3\u7EDD\uFF09\u201C\u7238\uFF0C\u5988\uFF01\u8FD9\u4E2A\u4FE1\u6807\u80FD\u5F15\u5BFC\u4F60\u4EEC\u53BB\u4E00\u4E2A\u6682\u65F6\u7684\u5B89\u5168\u70B9\uFF01\u4F60\u4EEC\u5148\u8D70\uFF01\u201D\r\n\uFF08\u7236\u6BCD\u88AB\u63A8\u56DE\u73B0\u4EE3\u540E\uFF0C\u5979\u5229\u7528\u5BF9\u5730\u5F62\u7684\u719F\u6089\uFF0C\u77EB\u5065\u5730\u7FFB\u7A97\u800C\u51FA\uFF0C\u76F4\u5954\u5B66\u6821\u5E7F\u64AD\u7AD9\u3002\uFF09\r\n\uFF08\u62A2\u8FC7\u9EA6\u514B\u98CE\uFF0C\u58F0\u97F3\u901A\u8FC7\u6269\u97F3\u5668\u4F20\u904D\u6218\u573A\uFF09\u201C\u6240\u6709\u5730\u7403\u548C\u66FC\u6CE2\u7684\u58EB\u5175\u4EEC\uFF0C\u542C\u6211\u8BF4\uFF01\u4F60\u4EEC\u90FD\u88AB\u9A97\u4E86\uFF01\u8FD9\u6839\u672C\u4E0D\u662F\u6B63\u4E49\u7684\u6218\u4E89\uFF0C\u800C\u662F\u4F60\u4EEC\u9AD8\u5C42\u80AE\u810F\u7684\u653F\u6CBB\u6E05\u6D17\uFF01\u66FC\u6CE2\u661F\u7684\u4E8C\u628A\u624B\u8981\u6740\u5149\u4F60\u4EEC\u706D\u53E3\uFF0C\u5730\u7403\u7684\u6821\u957F\u8BA1\u5212\u7740\u540E\u7EED\u4FB5\u7565\uFF01\u4E0D\u8981\u518D\u4E3A\u8FD9\u4E9B\u9634\u8C0B\u5BB6\u5356\u547D\u4E86\uFF0C\u770B\u770B\u4F60\u8EAB\u8FB9\u7684\u6218\u53CB\uFF0C\u4ED6\u4EEC\u548C\u4F60\u4E00\u6837\uFF0C\u90FD\u662F\u88AB\u8499\u853D\u7684\u666E\u901A\u4EBA\uFF01\u201D\r\n\uFF08\u5E7F\u64AD\u5F15\u53D1\u9A9A\u52A8\uFF0C\u8FFD\u5175\u5C06\u81F3\u3002\u55B5\u55B5\u7AD9\u4E0A\u5E7F\u64AD\u5854\u9876\uFF0C\u4FEF\u77B0\u4E0B\u65B9\u9010\u6E10\u505C\u606F\u7684\u6218\u573A\uFF0C\u7EB5\u8EAB\u4E00\u8DC3\uFF0C\u8EAB\u5F71\u6D88\u5931\u5728\u5149\u8292\u4E2D\u3002\uFF09\u201C\u81F3\u5C11\u2026\u2026\u6211\u5524\u9192\u4E86\u4E00\u4E9B\u4EBA\u3002\u201D\r\n\uFF08\u8BDD\u97F3\u672A\u843D\uFF0C\u4ED6\u7684\u7236\u6BCD\u5BF9\u89C6\u4E00\u773C\uFF0C\u773C\u4E2D\u662F\u4E86\u7136\u4E0E\u51B3\u7EDD\u3002\uFF09\uFF08\u7528\u529B\u5C06\u8C1C\u5965\u63A8\u5411\u521A\u521A\u7A33\u5B9A\u6210\u578B\u7684\u65F6\u7A7A\u901A\u9053\u5165\u53E3\uFF0C\u6148\u7231\u800C\u6025\u4FC3\u5730\u8BF4\uFF09\u201C\u5B69\u5B50\uFF0C\u80FD\u518D\u89C1\u4F60\u4E00\u9762\uFF0C\u77E5\u9053\u771F\u76F8\uFF0C\u5C31\u591F\u4E86\uFF01\u672A\u6765\u7684\u8DEF\uFF0C\u4F60\u8981\u66FF\u6211\u4EEC\u597D\u597D\u8D70\u4E0B\u53BB\uFF01\u201D\r\n\uFF08\u542B\u6CEA\u5FAE\u7B11\uFF09\u201C\u5FEB\u8D70\uFF01\u8BB0\u4F4F\uFF0C\u65E0\u8BBA\u661F\u9645\u95F4\u5982\u4F55\u4E89\u6597\uFF0C\u4F60\u90FD\u8981\u505A\u4E00\u4E2A\u5584\u826F\u7684\u4EBA\uFF01\u201D\uFF08\u8C1C\u5965\u72EC\u81EA\u56DE\u5230\u73B0\u4EE3\u7684\u5B9E\u9A8C\u5BA4\uFF0C\u8DEA\u5012\u5728\u5730\uFF0C\u5931\u58F0\u75DB\u54ED\u3002\uFF09\r\n\uFF08\u58F0\u97F3\u56E0\u7EDD\u671B\u800C\u51B0\u51B7\uFF09\u201C\u771F\u76F8\u2026\u2026\u653F\u6CBB\u2026\u2026\u4EC7\u6068\u2026\u2026\u8FD9\u4E00\u5207\u90FD\u592A\u4E11\u964B\u4E86\u3002\u6211\u538C\u5026\u4E86\u661F\u7403\u4E4B\u95F4\u7684\u7B97\u8BA1\u548C\u535A\u5F08\u3002\u201D\r\n\uFF08\u591A\u5E74\u540E\uFF0C\u4ED6\u6210\u4E3A\u4E00\u540D\u7A7F\u68AD\u4E8E\u5404\u661F\u9645\u96BE\u6C11\u8425\u7684\u65E0\u56FD\u754C\u533B\u751F\uFF0C\u7528\u533B\u672F\u800C\u975E\u6B66\u529B\u53BB\u5F25\u8865\u6218\u4E89\u5E26\u6765\u7684\u521B\u4F24\u3002\u5F53\u5979\u4E3A\u4E00\u540D\u53D7\u4F24\u7684\u66FC\u6CE2\u661F\u513F\u7AE5\u5305\u624E\u65F6\uFF0C\u773C\u795E\u6062\u590D\u4E86\u5E73\u9759\u4E0E\u575A\u5B9A\u3002\uFF09\r\n\uFF08\u5BF9\u54ED\u6CE3\u7684\u5B69\u5B50\u6E29\u67D4\u5730\u8BF4\uFF09\u201C\u522B\u6015\uFF0C\u75BC\u75DB\u5F88\u5FEB\u5C31\u4F1A\u8FC7\u53BB\u3002\u5728\u8FD9\u91CC\uFF0C\u6CA1\u6709\u66FC\u6CE2\u661F\u4EBA\u6216\u5730\u7403\u4EBA\uFF0C\u53EA\u6709\u9700\u8981\u5E2E\u52A9\u7684\u4EBA\u3002\u201D"
