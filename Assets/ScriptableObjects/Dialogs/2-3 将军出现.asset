%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "2-3 \u5C06\u519B\u51FA\u73B0"
  m_EditorClassIdentifier: 
  dialogID: 203
  DialogLines:
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u7AD9\u4F4F\uFF0C\u4F60\u8FD9\u4E2A\u5730\u7403\u7684\u53DB\u5F92\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u6CA1\u60F3\u5230\u5C06\u519B\u7ADF\u7136\u4F1A\u4EB2\u81EA\u51FA\u95E8\u7F09\u62FF\u6211\u2026\u2026\u6211\u662F\u5730\u7403\u7684\u53DB\u5F92\uFF1F\u660E\u660E\u662F\u4F60\u4EEC\u7684\u6240\u4F5C\u6240\u4E3A\uFF0C\u80CC\u53DB\u4E86\u5730\u7403\u548C\u66FC\u6CE2\u661F\u7684\u4EBA\u6C11\uFF01"
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u4F60\u61C2\u4EC0\u4E48\uFF0C\u6211\u4EEC\u8FD9\u4E48\u505A\uFF0C\u90FD\u662F\u4E3A\u4E86\u5730\u7403\u548C\u66FC\u6CE2\u661F\u7684\u548C\u5E73\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u548C\u5E73\uFF1F\u6700\u5F00\u59CB\u7684\u65F6\u5019\uFF0C\u4E24\u4E2A\u661F\u7403\u7684\u9886\u5BFC\u4EBA\u5C31\u90FD\u662F\u4E3A\u4E86\u4E00\u5DF1\u79C1\u6B32\uFF0C\u53D1\u52A8\u4E86\u5927\u89C4\u6A21\u661F\u9645\u6218\u4E89\uFF0C\u6218\u706B\u8FDE\u7EF5\uFF0C\u917F\u6210\u4E86\u591A\u5C11\u60B2\u5267\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4EC0\u4E48\uFF0C\u5730\u7403\u548C\u66FC\u6CE2\u661F\u8FD8\u7206\u53D1\u8FC7\u6218\u4E89\uFF1F\u6211\u600E\u4E48\u4E0D\u77E5\u9053\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u8FD9\u548C\u6211\u4EEC\u5728\u5386\u53F2\u8BFE\u672C\u91CC\u5B66\u5230\u7684\u53EF\u4E0D\u4E00\u6837\u2026\u2026\u4E24\u4E2A\u661F\u7403\u4E0D\u662F\u4ECE\u6700\u5F00\u59CB\u5C31\u4E00\u76F4\u53CB\u597D\u5F80\u6765\u7684\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u6218\u706B\u8086\u8650\u4E86\u51E0\u5E74\u90FD\u6CA1\u6709\u7ED3\u675F\uFF0C\u4EBA\u6C11\u4E5F\u5BF9\u653F\u5E9C\u8D8A\u53D1\u4E0D\u6EE1\u3002\u90A3\u4E9B\u9886\u5BFC\u4EBA\u773C\u89C1\u81EA\u5DF1\u5931\u53BB\u5A01\u4FE1\uFF0C\u4E3A\u4E86\u5DE9\u56FA\u81EA\u8EAB\u7EDF\u6CBB\uFF0C\u7ADF\u7136\u51B3\u5B9A\u91C7\u7528\u88AB\u7981\u6B62\u7684\u5371\u9669\u6280\u672F\u2026\u2026"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u4ED6\u4EEC\u8FDB\u884C\u4E86\u4E00\u573A\u661F\u7403\u89C4\u6A21\u7684\u6D17\u8111\uFF0C\u6E05\u9664\u4E86\u5730\u7403\u548C\u66FC\u6CE2\u661F\u7684\u6240\u6709\u666E\u901A\u6C11\u4F17\u5173\u4E8E\u90A3\u573A\u6218\u4E89\u7684\u8BB0\u5FC6\uFF01"
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u8FD9\u660E\u660E\u662F\u4E3A\u4E86\u8BA9\u4E24\u4E2A\u661F\u7403\u7684\u4EBA\u6C11\u653E\u4E0B\u4EC7\u6068\uFF0C\u53EA\u6709\u5FD8\u6389\u90A3\u4E9B\u4E0D\u6109\u5FEB\u7684\u8BB0\u5FC6\uFF0C\u624D\u80FD\u5B66\u4F1A\u91CD\u65B0\u548C\u5E73\u5171\u5904\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u5386\u53F2\u9700\u8981\u88AB\u6B63\u89C6\uFF01\u66F4\u4F55\u51B5\u90A3\u4E48\u591A\u5728\u6218\u4E89\u4E2D\u727A\u7272\u7684\u58EB\u5175\u548C\u65E0\u8F9C\u767E\u59D3\uFF0C\u6E05\u9664\u4E86\u4EBA\u6C11\u5173\u4E8E\u6218\u4E89\u7684\u8BB0\u5FC6\u540E\uFF0C\u8FD8\u6709\u8C01\u53BB\u7EAA\u5FF5\u4ED6\u4EEC\uFF1F\u96BE\u9053\u8BA9\u4ED6\u4EEC\u767D\u767D\u727A\u7272\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u522B\u518D\u72E1\u8FA9\u4E86\uFF01\u6709\u4EC0\u4E48\u8BDD\uFF0C\u7559\u5230\u519B\u4E8B\u6CD5\u5EAD\u4E0A\u8BF4\u5427\uFF01"
