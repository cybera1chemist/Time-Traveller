  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: 1-2
  m_EditorClassIdentifier: 
  dialogID: 2
  DialogLines:
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u522B\u3001\u522B\u6253\u4E86\uFF01\u521A\u624D\u7684\u6D77\u76D7\u6253\u626E\u662F\u6613\u5BB9\u672F\uFF01\u6211\u662F\u5730\u7403\u4EBA\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u54A6\uFF1F\u6211\u89C1\u8FC7\u4F60\uFF01\u4F60\u4E0D\u662F\u6211\u4EEC\u5B66\u6821\u7684\u90A3\u4E2A\u9752\u4E91\u5251\u5B97\u5C0F\u5C11\u7237\u5417\uFF0C\u6211\u7ECF\u5E38\u5728\u65B0\u95FB\u91CC\u770B\u5230\u4F60\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u6CA1\u9519\uFF0C\u5728\u4E0B\u6B63\u662F\u5F53\u4ECA\u5730\u7403\u4E0A\u89C4\u6A21\u6700\u5927\u7684\u5B97\u95E8\u9752\u4E91\u5251\u5B97\u7684\u5F1F\u5B50\u517C\u638C\u95E8\u7EE7\u627F\u4EBA\uFF0C\u590D\u59D3\u8BF8\u845B\uFF0C\u540D\u53EB\u597D\u5E05\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u8BF8\u845B\u597D\u5E05\uFF1F\u989D\u2026\u2026\u6211\u53EB\u674E\u561F\u561F\uFF0C\u4E5F\u662F\u8FD9\u6240\u5B66\u6821\u91CC\u7684\u5B66\u751F\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4E0D\u4E45\u524D\u660E\u660E\u8FD8\u5728\u4E3E\u884C\u6821\u5E86\u5178\u793C\uFF0C\u7A81\u7136\uFF0C\u6211\u542C\u89C1\u4E00\u58F0\u5DE8\u5927\u7684\u7206\u70B8\u58F0\uFF0C\u7136\u540E\u5C31\u6655\u5012\u4E86\uFF0C\u9192\u6765\u65F6\u5C31\u53D1\u73B0\u5B66\u6821\u53D8\u6210\u4E86\u5E9F\u589F\uFF0C\u800C\u4E14\u540C\u5B66\u4EEC\u3001\u8001\u5E08\u4EEC\u90FD\u4E0D\u89C1\u4E86\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u6211\u548C\u4F60\u7684\u7ECF\u5386\u5DEE\u4E0D\u591A\uFF01\u6211\u9192\u6765\u540E\u53D1\u73B0\u8EAB\u65C1\u6709\u4E00\u4E2A\u66FC\u6CE2\u661F\u4EBA\u5B87\u5B99\u6D77\u76D7\uFF0C\u7B80\u76F4\u5413\u4E86\u4E00\u8DF3\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u4E8E\u662F\u6211\u5C31\u628A\u4ED6\u6572\u6655\u4E86\uFF0C\u6362\u4E0A\u4ED6\u7684\u8863\u670D\uFF0C\u7528\u6613\u5BB9\u672F\u5047\u626E\u6210\u6D77\u76D7\uFF0C\u6DF7\u5728\u4ED6\u4EEC\u4E2D\u95F4\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u5BF9\u4E86\uFF0C\u4F60\u77E5\u9053\u4ECA\u5E74\u662F\u54EA\u4E00\u5E74\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "2114\u5E74\u5440\uFF0C\u4ECA\u5E74\u662F\u9999\u8549\u6E2F\u4E2D\u6587\u5927\u5B66\u5EFA\u6821\u4E00\u767E\u5468\u5E74\u6821\u5E86\uFF0C\u6211\u80AF\u5B9A\u4E0D\u4F1A\u8BB0\u9519\u7684\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u5947\u602A\u7684\u662F\uFF0C\u6211\u521A\u624D\u5728\u90A3\u4E9B\u6D77\u76D7\u7684\u5BF9\u8BDD\u4E2D\uFF0C\u542C\u5230\u4ED6\u4EEC\u63D0\u5230\u8BF4\u4ECA\u5E74\u662F2110\u5E74\uFF0C\u4E5F\u5C31\u662F\u56DB\u5E74\u524D\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u600E\u4E48\u53EF\u80FD\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u6211\u4EB2\u8033\u542C\u89C1\u7684\uFF01\u6211\u8FD8\u542C\u89C1\u4ED6\u4EEC\u8BF4\uFF0C\u4ED6\u4EEC\u8981\u5360\u9886\u6211\u4EEC\u6821\u56ED\u4F5C\u4E3A\u636E\u70B9\uFF0C\u8FDB\u800C\u593A\u53D6\u9999\u8549\u6E2F\u3002\u5B66\u6821\u91CC\u7684\u5E08\u751F\u53EA\u6709\u5C0F\u90E8\u5206\u9003\u8D70\u4E86\uFF0C\u5269\u4E0B\u7684\u5168\u90FD\u88AB\u4ED6\u4EEC\u6293\u8D70\u4E86\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u53EF\u6076\u7684\u54C8\u57FA\u7C73\u2026\u2026\n\u5C0F\u5FC3\u70B9\uFF0C\u53C8\u6709\u6D77\u76D7\u8FC7\u6765\u4E86\uFF01"
