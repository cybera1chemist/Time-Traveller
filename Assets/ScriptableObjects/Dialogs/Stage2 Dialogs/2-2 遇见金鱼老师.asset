  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "2-2 \u9047\u89C1\u91D1\u9C7C\u8001\u5E08"
  m_EditorClassIdentifier: 
  dialogID: 202
  DialogLines:
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u91D1\u9C7C\u8001\u5E08\uFF01\u60A8\u600E\u4E48\u4E5F\u5728\u8FD9\u91CC\uFF1F"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u2026\u2026\uFF01\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u54C7\uFF0C\u91D1\u9C7C\u8001\u5E08\uFF0C\u96BE\u9053\u4F60\u4E5F\u8DDF\u6211\u4EEC\u4E00\u8D77\u7A7F\u8D8A\u5230\u8FC7\u53BB\u4E86\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u8001\u5E08\uFF0C\u4F60\u8FD9\u8EAB\u6253\u626E\uFF0C\u662F\u5077\u5077\u62FF\u4E86\u7814\u7A76\u6240\u91CC\u7684\u767D\u5927\u8902\uFF0C\u8981\u5047\u626E\u6210\u7814\u7A76\u5458\u5728\u8FD9\u513F\u8C03\u67E5\u5417\uFF1F\u771F\u662F\u673A\u667A\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u4F60\u4EEC\u2026\u2026\u662F\u4EC0\u4E48\u4EBA\uFF1F\u6211\u4EEC\u4E4B\u524D\u8BA4\u8BC6\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4EC0\u4E48\uFF01\u8001\u5E08\uFF0C\u4F60\u7ADF\u7136\u4E0D\u8BB0\u5F97\u6211\u4EEC\u4E86\u5417\uFF1F\u6211\u548C\u4ED6\u4EEC\u4FE9\u90FD\u662F\u4F60\u7684\u865A\u62DF\u73B0\u5B9E\u6E38\u620F\u8BFE\u4E0A\u7684\u5B66\u751F\uFF0C\u800C\u6D77\u85FB\u662F\u4F60\u7684\u52A9\u6559\u5440\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u4F60\u4EEC\u662F\u4E0D\u662F\u8BA4\u9519\u4EBA\u4E86\uFF1F\u6211\u4ECE\u6765\u6CA1\u6709\u5F53\u8FC7\u8001\u5E08\u5440\u3002\u5148\u4E0D\u804A\u5929\u4E86\uFF0C\u73B0\u5728\u60C5\u51B5\u5371\u6025\uFF0C\u6211\u5FC5\u987B\u8981\u8D76\u5FEB\u79BB\u5F00\u8FD9\u91CC\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u8FD9\u91CC\u8FD9\u4E48\u591A\u8FFD\u5175\uFF0C\u60A8\u4E00\u4E2A\u4EBA\u4E0D\u5B89\u5168\uFF0C\u8BA9\u6211\u4EEC\u62A4\u9001\u60A8\u9003\u79BB\u7814\u7A76\u6240\u5427\uFF01"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u6CA1\u9519\uFF0C\u800C\u4E14\u6211\u4EEC\u521A\u597D\u4E5F\u6709\u8BB8\u591A\u95EE\u9898\u60F3\u8981\u8BF7\u6559\u60A8\u2026\u2026"
