%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "3-7 \u5728\u6B66\u5668\u63A7\u5236\u5BA4\u95E8\u53E3"
  m_EditorClassIdentifier: 
  dialogID: 306
  DialogLines:
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4F60\u4EEC\u6CE8\u610F\u5230\u521A\u624D\u829D\u9EBB\u76D6\u5976\u548C\u8D6B\u5229\u4FC4\u65AF\u7684\u6001\u5EA6\u4E86\u5417\uFF1F\u5728\u4E86\u89E3\u5230\u5730\u7403\u548C\u66FC\u6CE2\u661F\u7684\u51B2\u7A81\u53EA\u662F\u7531\u6587\u5316\u5DEE\u5F02\u5F15\u8D77\u7684\u8BEF\u4F1A\u4E4B\u540E\uFF0C\u4ED6\u4EEC\u5C31\u4E0D\u90A3\u4E48\u538C\u6076\u4EBA\u7C7B\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u662F\u8FD9\u6837\u7684\uFF0C\u4E60\u60EF\u4E86\u4F60\u4EEC\u5730\u7403\u4EBA\u5C31\u597D\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u5DEE\u70B9\u90FD\u5FD8\u4E86\uFF0C\u4F60\u4E5F\u662F\u66FC\u6CE2\u661F\u4EBA\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u8FD9\u4E48\u4E00\u4E2A\u5C0F\u5C0F\u7684\u539F\u56E0\uFF0C\u5374\u6210\u4E3A\u51B2\u7A81\u7684\u5BFC\u706B\u7D22\uFF0C\u4E4B\u540E\u4E24\u4E2A\u661F\u7403\u7684\u5BF9\u6297\u6108\u6F14\u6108\u70C8\uFF0C\u53D8\u6210\u4E86\u5927\u89C4\u6A21\u661F\u9645\u6218\u4E89\uFF0C\u8BB8\u8BB8\u591A\u591A\u65E0\u8F9C\u7684\u5730\u7403\u4EBA\u548C\u54C8\u57FA\u7C73\u90FD\u5931\u53BB\u4E86\u751F\u547D\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u5982\u679C\u6211\u4EEC\u53EF\u4EE5\u5411\u66F4\u591A\u7684\u54C8\u57FA\u7C73\u89E3\u5F00\u8FD9\u4E2A\u8BEF\u4F1A\uFF0C\u662F\u4E0D\u662F\u5C31\u53EF\u4EE5\u8BA9\u4ED6\u4EEC\u53D6\u6D88\u8FD9\u6B21\u5077\u88AD\u5730\u7403\u7684\u884C\u52A8\uFF0C\u4ECE\u800C\u963B\u6B62\u8FD9\u573A\u6218\u4E89\u5462\uFF1F\u90A3\u53EF\u4EE5\u62EF\u6551\u591A\u5C11\u4EBA\u5440\uFF01"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u4F46\u662F\uFF0C\u6539\u53D8\u8FC7\u53BB\u5B9E\u9645\u4E0A\u5DF2\u7ECF\u53D1\u751F\u4E86\u7684\u4E8B\u60C5\uFF0C\u4F1A\u6709\u4E0D\u53EF\u77E5\u7684\u540E\u679C\u3002"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u5982\u679C\u6CA1\u6709\u8FD9\u573A\u6218\u4E89\uFF0C\u91D1\u9C7C\u8001\u5E08\u5C31\u4E0D\u4F1A\u60F3\u8981\u7814\u5236\u65F6\u5149\u673A\uFF0C\u6211\u4EEC\u5C31\u4E0D\u4F1A\u7A7F\u8D8A\u5230\u8FD9\u91CC\u2026\u2026\u8FD9\u6837\u5C31\u5F15\u8D77\u65F6\u7A7A\u6096\u8BBA\u4E86\uFF0C\u6211\u4EEC\u7684\u4E0B\u573A\u4E5F\u4E0D\u77E5\u9053\u4F1A\u600E\u6837\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u800C\u5982\u679C\u6211\u4EEC\u53EA\u662F\u5C06\u65F6\u7A7A\u6F0F\u6D1E\u4FEE\u590D\uFF0C\u5C31\u80FD\u56DE\u5230\u6211\u4EEC\u539F\u672C\u7684\u65F6\u7A7A\uFF0C\u8FC7\u4E0A\u4E4B\u524D\u7684\u751F\u6D3B\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u6240\u4EE5\u5462\uFF0C\u4F60\u5E0C\u671B\u5192\u7740\u727A\u7272\u81EA\u5DF1\u7684\u98CE\u9669\uFF0C\u53BB\u62EF\u6551\u8BB8\u8BB8\u591A\u591A\u7684\u5176\u4ED6\u4EBA\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u8FD9\uFF0C\u6211\u4E0D\u77E5\u9053\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u561F\u561F\uFF0C\u6211\u8EAB\u4E3A\u4EBA\u5DE5\u667A\u80FD\u52A9\u6559\uFF0C\u804C\u8D23\u5C31\u662F\u5E2E\u52A9\u5B66\u751F\u548C\u5B88\u62A4\u5B66\u751F\u7684\u7406\u60F3\u3002\u56E0\u6B64\uFF0C\u65E0\u8BBA\u4F60\u4EEC\u505A\u51FA\u54EA\u4E00\u79CD\u51B3\u5B9A\uFF0C\u6211\u90FD\u4F1A\u5C0A\u91CD\u548C\u652F\u6301\u4F60\u4EEC\u7684\u51B3\u5B9A\u7684\u3002"
