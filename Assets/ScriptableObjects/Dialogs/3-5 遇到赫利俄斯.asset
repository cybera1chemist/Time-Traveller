  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "3-5 \u9047\u5230\u8D6B\u5229\u4FC4\u65AF"
  m_EditorClassIdentifier: 
  dialogID: 305
  DialogLines:
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u7AD9\u4F4F\uFF01\u4F60\u4EEC\u662F\u8C01\uFF0C\u4E3A\u4EC0\u4E48\u5728\u661F\u8230\u9644\u8FD1\u4E71\u901B\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u4F60\u53C8\u662F\u8C01\uFF1F\u4E3A\u4EC0\u4E48\u5728\u661F\u8230\u9644\u8FD1\u4E71\u901B\uFF1F"
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u4F60\u6CA1\u770B\u5230\u6211\u8FD9\u4E48\u5E05\u7684\u5DE1\u903B\u8F66\u5417\uFF1F\u6211\u5F53\u7136\u662F\u66FC\u6CE2\u661F\u7B2C\u4E00\u519B\u7684\u5DE1\u903B\u5458\u8D6B\u5229\u4FC4\u65AF\uFF0C\u8D1F\u8D23\u5DE1\u89C6\u7EB3\u7F8E\u8DEF\u591A\u53F7\u661F\u8230\u5468\u8FB9\u7684\u2026\u2026\u8BF6\u7B49\u7B49\uFF0C\u4F60\u4EEC\u600E\u4E48\u8D70\u4E86\uFF0C\u6211\u8FD8\u6CA1\u81EA\u6211\u4ECB\u7ECD\u5B8C\u5462\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u4EEC\u8D76\u65F6\u95F4\u53BB\u62EF\u6551\u5730\u7403\uFF01"
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u7ED9\u6211\u7AD9\u4F4F\uFF01\u518D\u4E0D\u505C\u4E0B\u6211\u8981\u5F00\u70AE\u4E86\uFF01\n\u54C8\u2014\u2014\uFF01\uFF01\uFF01"
