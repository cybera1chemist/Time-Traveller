  m_Script: {fileID: 11500000, guid: 3b0058b5bedc25d4183616852448917a, type: 3}
  m_Name: "3-8 \u5C0F\u52C7\u6562"
  m_EditorClassIdentifier: 
  dialogID: 308
  DialogLines:
  - portrait: {fileID: 21300000, guid: 29c0123a32cf110449a56878d0313860, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u600E\u4E48\u65F6\u95F4\u8FD8\u6CA1\u5230\u5440\uFF0C\u6211\u90FD\u7B49\u4E0D\u53CA\u8981\u53D1\u5C04\u4E86\u2026\u2026\n\u55EF\uFF01\uFF1F\u4F60\u4EEC\u662F\u8C01\uFF0C\u7ADF\u6562\u64C5\u95EF\u91CD\u5730\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u522B\u614C\uFF0C\u662F\u829D\u9EBB\u76D6\u5976\u8BA9\u6211\u4EEC\u6765\u7684\uFF0C\u51ED\u8BC1\u5C31\u662F\u4ED6\u7ED9\u6211\u4EEC\u7684\u8054\u7EDC\u5668\uFF0C\u4F60\u770B\u3002"
  - portrait: {fileID: 21300000, guid: 29c0123a32cf110449a56878d0313860, type: 3}
    speakerName: "\uFF1F\uFF1F\uFF1F"
    content: "\u662F\u90A3\u5BB6\u4F19\u554A\uFF0C\u4ED6\u8BA9\u4F60\u4EEC\u6765\u5E72\u561B\uFF1F"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u4ED6\u521A\u624D\u6765\u4F20\u8FBE\u6307\u6325\u5B98\u547D\u4EE4\u7684\u65F6\u5019\uFF0C\u4E00\u4E0D\u5C0F\u5FC3\u8BF4\u9519\u4E86\uFF0C\u6240\u4EE5\u8BA9\u6211\u4EEC\u5E26\u8054\u7EDC\u5668\u6765\uFF0C\u4EB2\u81EA\u8054\u7CFB\u6307\u6325\u5B98\u786E\u8BA4\u547D\u4EE4\u3002"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u561F\u561F\uFF0C\u73B0\u5728\u6211\u4EEC\u6709\u673A\u4F1A\u76F4\u63A5\u548C\u66FC\u6CE2\u661F\u6700\u9AD8\u6307\u6325\u5B98\u5BF9\u8BDD\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u4F60\u662F\u5E0C\u671B\u4EC5\u4EC5\u7EA0\u6B63\u6700\u9AD8\u6307\u6325\u5B98\u7684\u547D\u4EE4\uFF0C\u4FEE\u590D\u65F6\u7A7A\u6F0F\u6D1E\uFF0C\u8FD8\u662F\u8BF4\u670D\u6700\u9AD8\u6307\u6325\u5B98\u4E0D\u8981\u5F00\u6218\uFF0C\u963B\u6B62\u8FD9\u573A\u6218\u4E89\uFF1F"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6211\u9009\u62E9\u2026\u2026"
  optionAText: "\u4EC5\u4FEE\u590D\u65F6\u7A7A\u6F0F\u6D1E"
  outcomeA: {fileID: 11400000, guid: b197c26c2d429fd4f927259bd99fa73d, type: 2}
  optionBText: "\u5C1D\u8BD5\u963B\u6B62\u6218\u4E89"
  outcomeB: {fileID: 11400000, guid: 8ed82ab2acbae24488a41b4b2e9ad89d, type: 2}
