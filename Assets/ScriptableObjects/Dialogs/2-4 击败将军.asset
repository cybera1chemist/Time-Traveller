  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "2-4 \u51FB\u8D25\u5C06\u519B"
  m_EditorClassIdentifier: 
  dialogID: 204
  DialogLines:
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u989D\u554A\uFF01\u6211\u7ADF\u7136\u8D25\u7ED9\u4E86\u56DB\u4E2A\u5C0F\u9B3C\u2026\u2026\u4F60\u4EEC\u5230\u5E95\u662F\u4EC0\u4E48\u4EBA\uFF01"
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u53EF\u522B\u9AD8\u5174\u5F97\u592A\u65E9\uFF0C\u5C31\u7B97\u4F60\u9003\u51FA\u4E86\u7814\u7A76\u6240\uFF0C\u5C31\u51ED\u4F60\u4E5F\u60F3\u5C06\u6240\u8C13\u7684\u771F\u76F8\u516C\u4E4B\u4E8E\u4F17\uFF1F"
  - portrait: {fileID: 21300000, guid: 4dafa4ba53918344f9231aa7c1dacba0, type: 3}
    speakerName: "\u5C06\u519B"
    content: "\u54C8\u54C8\uFF01\u6CA1\u6709\u4EFB\u4F55\u8BC1\u636E\uFF0C\u4F1A\u6709\u4EBA\u76F8\u4FE1\u4F60\u5417\uFF1F\u53EA\u6015\u662F\u4F1A\u88AB\u5F53\u4F5C\u9F13\u5439\u9634\u8C0B\u8BBA\u7684\u795E\u7ECF\u75C5\uFF0C\u6CA6\u4E3A\u7B11\u67C4\u5427\uFF01"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u4EC0\u4E48\uFF01\u8FD9\u2026\u2026"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u5BF9\u4E86\uFF0C\u6211\u8BB0\u5F97\u4F60\u4EEC\u8BF4\u8FC7\uFF0C\u4F60\u4EEC\u662F\u7A7F\u8D8A\u8FC7\u6765\u7684\uFF1F\u4F60\u4EEC\u771F\u7684\u4E0D\u77E5\u9053\u5730\u7403\u548C\u66FC\u6CE2\u661F\u7206\u53D1\u8FC7\u6218\u4E89\u5417\uFF1F"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u6CA1\u9519\u3002\u6211\u4EEC\u6765\u81EA2114\u5E74\uFF0C\u800C\u4E14\u6211\u4EEC\u786E\u5B9E\u6CA1\u6709\u542C\u8BF4\u8FC7\u90A3\u573A\u6218\u4E89\u3002"
  - portrait: {fileID: 21300000, guid: e5cf3fc271c678e43bdd4f32480ac139, type: 3}
    speakerName: "\u91D1\u9C7C\u8001\u5E08"
    content: "\u4ECA\u5E74\u662F2104\u5E74\u3002\u96BE\u9053\u8BF4\uFF0C\u672A\u6765\u7684\u6211\u771F\u7684\u5931\u8D25\u4E86\uFF0C\u6CA1\u80FD\u63ED\u9732\u771F\u76F8\u2026\u2026"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u4E0D\u662F\u7684\uFF0C\u8001\u5E08\u5176\u5B9E\u4E00\u76F4\u6CA1\u6709\u653E\u5F03\u52AA\u529B\uFF01\u662F\u4E3A\u4E86\u80FD\u8BF4\u670D\u522B\u4EBA\uFF0C\u5728\u6536\u96C6\u8BC1\u636E\u3002"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u5728\u9003\u51FA\u7814\u7A76\u6240\u540E\uFF0C\u8001\u5E08\u4E00\u76F4\u5728\u7814\u7A76\u65F6\u95F4\u4FE1\u606F\u5DE5\u7A0B\uFF0C\u5E76\u53D1\u73B0\u4E86\u4E00\u79CD\u7406\u8BBA\uFF0C\u53EF\u4EE5\u5C06\u8FC7\u53BB\u7684\u65F6\u7A7A\u76F4\u63A5\u6295\u5F71\u5230\u73B0\u5728\uFF0C\u4ECE\u800C\u5C55\u793A\u51FA\u5386\u53F2\u7684\u771F\u76F8\uFF0C\u8FD9\u5C06\u662F\u65E0\u6CD5\u8D28\u7591\u7684\u8BC1\u636E\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u6D77\u85FB\uFF0C\u4F60\u4E3A\u4EC0\u4E48\u4F1A\u77E5\u9053\u8FD9\u4E48\u591A\uFF1F"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u56E0\u4E3A\u6211\u5176\u5B9E\u4E00\u76F4\u5728\u6697\u4E2D\u5E2E\u52A9\u91D1\u9C7C\u8001\u5E08\u7814\u53D1\u65F6\u7A7A\u6295\u5F71\u88C5\u7F6E\u3002\u4F46\u5728\u6821\u5E86\u5178\u793C\u90A3\u5929\uFF0C\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\uFF0C\u5B9E\u9A8C\u51FA\u73B0\u4E86\u6545\u969C\uFF0C\u88C5\u7F6E\u7206\u70B8\u4E86\uFF0C\u8FD8\u5F15\u8D77\u4E86\u65F6\u7A7A\u9519\u4E71\uFF0C\u6240\u4EE5\u6211\u4EEC\u624D\u88AB\u4F20\u9001\u5230\u4E86\u8FC7\u53BB\u2026\u2026"
