  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "3-4 \u51FB\u8D25\u829D\u9EBB\u76D6\u5976"
  m_EditorClassIdentifier: 
  dialogID: 304
  DialogLines:
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u53EF\u6076\u7684\u5730\u7403\u4EBA\uFF0C\u6211\u8BA8\u538C\u4F60\u4EEC\uFF01"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u5728\u6211\u4EEC\u90A3\u4E2A\u65F6\u7A7A\uFF0C\u5730\u7403\u4EBA\u548C\u54C8\u57FA\u7C73\u53EF\u662F\u4E00\u76F4\u4EE5\u6765\u90FD\u53CB\u597D\u76F8\u5904\u7684\uFF0C\u6CA1\u89C1\u8C01\u8FD9\u4E48\u8BA8\u538C\u5730\u7403\u4EBA\u3002\u4F60\u8FD9\u53EF\u662F\u8D64\u88F8\u88F8\u7684\u79CD\u65CF\u6B67\u89C6\uFF01"
  - portrait: {fileID: 21300000, guid: 30e25c23b0fe4a44e83249e89c972dff, type: 3}
    speakerName: "\u6D77\u85FB"
    content: "\u829D\u9EBB\u76D6\u5976\uFF0C\u4F60\u548C\u5176\u4ED6\u7684\u54C8\u57FA\u7C73\u4E3A\u4EC0\u4E48\u8FD9\u4E48\u8BA8\u538C\u4EBA\u7C7B\u5440\uFF1F"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u8FD8\u4E0D\u662F\u56E0\u4E3A\u4F60\u4EEC\u8FD9\u4E9B\u611A\u8822\u7684\u5730\u7403\u4EBA\u5BF9\u6211\u4EEC\u7684\u654C\u610F\u8FD9\u4E48\u5927\uFF01\u5168\u66FC\u6CE2\u661F\u7684\u54C8\u57FA\u7C73\u90FD\u77E5\u9053\uFF0C\u5730\u7403\u4EBA\u7ECF\u5E38\u65E0\u7F18\u65E0\u6545\u7684\u54C8\u6C14\u3002"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u54C8\uFF1F\u4EC0\u4E48\u610F\u601D\uFF1F"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u54C8\u2014\u2014\uFF01\uFF01\uFF01"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u5509\uFF0C\u6211\u6765\u89E3\u91CA\u4E00\u4E0B\u5427\u3002\u66FC\u6CE2\u661F\u548C\u5730\u7403\u6709\u4E00\u4E9B\u6587\u5316\u5DEE\u5F02\uFF0C\u5728\u66FC\u6CE2\u661F\uFF0C\u201C\u54C8\u201D\u662F\u8868\u793A\u5A01\u80C1\u548C\u6124\u6012\u7684\u610F\u601D\uFF0C\u800C\u5728\u5730\u7403\uFF0C\u201C\u54C8\u201D\u5219\u8868\u793A\u7684\u662F\u5F00\u5FC3\u548C\u597D\u7B11\uFF0C"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u554A\uFF0C\u539F\u6765\u662F\u8FD9\u6837\u5417\uFF1F\u6211\u4EEC\u66FC\u6CE2\u661F\u7684\u6700\u9AD8\u6307\u6325\u5B98\u56E0\u4E3A\u53D7\u4E0D\u4E86\u5730\u7403\u4EBA\u8001\u662F\u54C8\u6C14\uFF0C\u90FD\u51B3\u5B9A\u8981\u5411\u5730\u7403\u5F00\u6218\u4E86\uFF0C\u8FD9\u6837\u770B\u6765\uFF0C\u597D\u50CF\u53EA\u662F\u8BEF\u4F1A\u5440\u3002"
  - portrait: {fileID: 21300000, guid: 0f8faedb655d9094f8ade9d618c1fd50, type: 3}
    speakerName: "\u674E\u561F\u561F"
    content: "\u4F60\u4EEC\u7ADF\u7136\u5C31\u56E0\u4E3A\u8FD9\u79CD\u5C0F\u4E8B\u5F00\u6218\u5417\uFF1F\n\u54C8\u2014\u2014\uFF01\uFF01\uFF01"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u597D\u50CF\u786E\u5B9E\u53EA\u662F\u5C0F\u4E8B\u2026\u2026\u8981\u662F\u5730\u7403\u5C31\u56E0\u4E3A\u8FD9\u4E2A\u8BEF\u4F1A\u88AB\u6BC1\u706D\u4E86\uFF0C\u4E5F\u592A\u53EF\u601C\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u7ED9\u4F60\u4EEC\uFF0C\u8FD9\u662F\u7528\u6765\u8054\u7EDC\u6307\u6325\u5B98\u7684\u901A\u8BAF\u5668\uFF0C\u4F60\u4EEC\u5FEB\u53BB\u6B66\u5668\u63A7\u5236\u5BA4\u963B\u6B62\u963F\u59C6\u65AF\u7279\u6717\u6FC0\u5149\u70AE\u53D1\u5C04\u5427\uFF01"
  - portrait: {fileID: 21300000, guid: 502984a468d49d844898426879ca86d4, type: 3}
    speakerName: "\u829D\u9EBB\u76D6\u5976"
    content: "\u7ED9\u4F60\u4EEC\uFF0C\u8FD9\u662F\u7528\u6765\u8054\u7EDC\u6307\u6325\u5B98\u7684\u901A\u8BAF\u5668\uFF0C\u4F60\u4EEC\u5FEB\u53BB\u661F\u8230\u5916\u9762\u7684\u6B66\u5668\u63A7\u5236\u5BA4\uFF0C\u963B\u6B62\u963F\u59C6\u65AF\u7279\u6717\u6FC0\u5149\u70AE\u53D1\u5C04\u5427\uFF01"
  - portrait: {fileID: 21300000, guid: 0f2e5cfdc21e424449a94c3dd2baa727, type: 3}
    speakerName: "\u8BF8\u845B\u597D\u5E05"
    content: "\u5E78\u597D\u6211\u521A\u624D\u5728\u4ED3\u5E93\u91CC\u987A\u4E86\u51E0\u74F6\u592A\u7A7A\u9002\u5E94\u5242\uFF0C\u521A\u521A\u597D\u5927\u5BB6\u4E00\u4EBA\u4E00\u74F6\u3002\u4E8B\u4E0D\u5B9C\u8FDF\uFF0C\u6211\u4EEC\u5FEB\u51FA\u53BB\u5427\u3002"
