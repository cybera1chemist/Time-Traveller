  m_Script: {fileID: 11500000, guid: 5c06808e2e2c2e242baa95a56093da65, type: 3}
  m_Name: "3-6 \u51FB\u8D25\u8D6B\u5229\u4FC4\u65AF"
  m_EditorClassIdentifier: 
  dialogID: 306
  DialogLines:
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u4F60\u4EEC\u8FD9\u4E9B\u53EA\u4F1A\u65E0\u7F18\u65E0\u6545\u54C8\u6C14\u7684\u53EF\u6076\u7684\u5730\u7403\u4EBA\uFF0C\u6211\u8BA8\u538C\u4F60\u4EEC\uFF01"
  - portrait: {fileID: 21300000, guid: 516c8a9b4a9ca8d459943b6ac9896c8a, type: 3}
    speakerName: "\u8C1C\u5965\xB7\u79D2\u63CF\u9088"
    content: "\u5509\uFF0C\u6211\u6765\u89E3\u91CA\u4E00\u4E0B\u5427\u3002\u66FC\u6CE2\u661F\u548C\u5730\u7403\u6709\u4E00\u4E9B\u6587\u5316\u5DEE\u5F02\uFF0C\u5728\u66FC\u6CE2\u661F\uFF0C\u201C\u54C8\u201D\u662F\u8868\u793A\u5A01\u80C1\u548C\u6124\u6012\u7684\u610F\u601D\uFF0C\u800C\u5728\u5730\u7403\uFF0C\u201C\u54C8\u201D\u5219\u8868\u793A\u7684\u662F\u5F00\u5FC3\u548C\u597D\u7B11\uFF0C"
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u539F\u6765\u662F\u8FD9\u6837\u5417\uFF1F\u90A3\u5730\u7403\u4EBA\u8FD8\u633A\u53EF\u601C\u7684\uFF0C\u56E0\u4E3A\u6211\u542C\u829D\u9EBB\u76D6\u5976\u8BF4\uFF0C\u8FD8\u6709\u51E0\u5206\u949F\u5730\u7403\u5C31\u8981\u88AB\u963F\u59C6\u65AF\u7279\u6717\u6FC0\u5149\u70AE\u8F70\u70B8\u4E86\u3002"
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u65E2\u7136\u53EA\u662F\u8BEF\u4F1A\uFF0C\u90A3\u6211\u5176\u5B9E\u4E5F\u6CA1\u6709\u90A3\u4E48\u5E0C\u671B\u5730\u7403\u88AB\u6BC1\u706D\u4E86\u2026\u2026"
  - portrait: {fileID: 21300000, guid: f6501c2abe000884b9f299d30f272f88, type: 3}
    speakerName: "\u8D6B\u5229\u4FC4\u65AF"
    content: "\u7ED9\u4F60\u4EEC\uFF0C\u8FD9\u662F\u6B66\u5668\u63A7\u5236\u5BA4\u7684\u94A5\u5319\uFF0C\u4F60\u4EEC\u5FEB\u53BB\u963B\u6B62\u81EA\u5DF1\u7684\u5BB6\u56ED\u88AB\u70B8\u98DE\u5427\u3002"
